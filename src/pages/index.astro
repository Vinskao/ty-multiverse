---
import { getCollection } from 'astro:content';
import algorithmsData from '../storages/algorithmsUsed.json';
import skillsData from '../storages/skills.json';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import { Icon } from '../components/Icon';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import SkillsBubbleChart from '../components/SkillsBubbleChart';
import AiTokenUsageDashboard from '../components/AiTokenUsageDashboard';
import ResearchZone from '../components/ResearchZone';
import companyProductMapping from '../storages/companyProductMapping.json';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';
import indexCssUrl from '../styles/index.css?url';
import MarketBrief from '../components/MarketBrief.astro';
import { getMarketBrief } from '../services/server/marketBrief';

// Server-rendered so AI agents that read raw HTML (no JS) still see the holdings' chip summary.
const marketBrief = await getMarketBrief();

// 準備 Bubble Chart 資料 - 從 skillsData 計算每個類別的總分
const shadeScores: { [key: string]: number } = {
	shade1: 5,
	shade2: 4,
	shade3: 3,
	shade4: 2,
	shade5: 1,
};

interface BubbleData {
	id: string;
	name: string;
	value: number;
	category: string;
}

const bubbleChartData: BubbleData[] = skillsData.categories.map((category: any) => {
	// Flatten skills from subcategories if they exist, otherwise use direct skills
	const allSkills = category.subcategories 
		? category.subcategories.flatMap((sub: any) => sub.skills)
		: category.skills || [];
	
	// Calculate total score for the category
	const totalScore = allSkills.reduce((sum: number, skill: any) => {
		return sum + (shadeScores[skill.level] || 0);
	}, 0);

	return {
		id: category.name,
		name: category.name,
		value: totalScore,
		category: category.name,
	};
});
// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// 修改服務器啟動時間的處理
let serverStartTime = new Date().toISOString();
try {
    // 使用環境變量或默認值
    serverStartTime = import.meta.env.SERVER_START_TIME || serverStartTime;
} catch (error) {
    console.error('Error getting server start time:', error);
}

// 檢查是否需要顯示登入提示
const showLoginAlert = Astro.url.searchParams.get('showLoginAlert') === 'true';

const algorithmsUsed = algorithmsData.algorithms;
const skillsCategories = skillsData.categories;

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---
<BaseLayout>
	<Fragment slot="head">
		<link rel="stylesheet" href={indexCssUrl} />
		<link rel="alternate" type="text/markdown" href="/tymultiverse/brief.md" title="持股籌碼摘要" />
		<link rel="alternate" type="application/json" href="/tymultiverse/brief.json" title="Holdings chip summary (JSON)" />
	</Fragment>
	<!-- Messenger Chat Plugin Code -->
	<div id="fb-root"></div>

	<!-- Your Chat Plugin code -->
	<div id="fb-customer-chat" class="fb-customerchat">
	</div>
	{showLoginAlert && 
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				const lang = (window.AppLang ? window.AppLang.get() : (localStorage.getItem('site_language') || 'en'));
				const title = lang === 'zh' ? '請先登入' : 'Please Login First';
				window.Swal.fire({
					title: title,
					icon: 'info',
					timer: 1000,
					showConfirmButton: false
				});
			});
		</script>
	}
	<div class="stack gap-20 lg:gap-48">

		<div class="wrapper stack gap-20 lg:gap-50">

			<header class="hero stack hero-layout">
				<div class="hero-main">
					<div class="hero-header">
						<h1 data-i18n="home.heroTitle">People System</h1>
						<p data-i18n="home.heroTagline">Java Backend Engineer | Enterprise Systems | Security Integration | AI/RAG Applications</p>
					</div>

					<section id="market-overview" class="market-overview">
						<div class="market-overview-header">
							<div>
								<h4 class="section-title" data-i18n="home.marketOverviewTitle">Market Overview</h4>
							</div>
							<p class="market-overview-note" data-i18n="home.marketOverviewNote">Refreshed every 10 minutes</p>
						</div>
						<section id="macro-dashboard" class="macro-dashboard" aria-labelledby="macro-dashboard-title" aria-live="polite">
							<div class="macro-dashboard-heading"><div><h4 id="macro-dashboard-title" data-i18n="home.macroTitle">Key macro data · U.S., Taiwan and more</h4><p data-i18n="home.macroDescription">Labor, inflation, rates, consumption, trade and FX for the U.S., Taiwan and other major economies, with upcoming release reminders.</p></div><span id="macro-dashboard-status" class="market-updated" data-i18n="home.macroLoading">Loading macro data…</span></div>
							<div id="macro-indicator-grid" class="macro-group-grid"><p class="market-updated" data-i18n="home.macroLoading">Loading macro data…</p></div>
							<div id="macro-event-list" class="macro-other-list" hidden></div>
							<section id="macro-commentary" class="market-ai-panel macro-commentary" aria-labelledby="macro-commentary-title">
								<div class="macro-commentary-heading"><h5 id="macro-commentary-title">總經評論｜所有個股分析共用</h5><span id="macro-commentary-meta" class="market-updated"></span></div>
								<div id="macro-commentary-body" class="macro-commentary-body"><p class="market-updated">載入總經評論中…</p></div>
								<details>
									<summary>更新總經評論（AI 提示、編輯、版本歷史）</summary>
									<section class="market-ai-research-prompt" aria-labelledby="macro-ai-prompt-title">
										<div class="market-ai-prompt-heading"><h5 id="macro-ai-prompt-title">總經 AI 研究提示</h5><button type="button" id="macro-ai-copy-prompt">複製完整提示</button></div>
										<pre id="macro-ai-prompt-text">你是總經研究員。這份評論是本站所有個股與期貨分析共用的總經前提，個股分析只引用、不重寫總經數據。依最新已公布資料更新下方「目前總經評論」，不得沿用前版而不重新驗證。

研究流程
1. 讀本區「多國重要總體經濟資料」與 API（GET /tymultiverse/api/market/dashboard/macro）：美國與台灣的就業／失業率、CPI／核心 CPI、PPI、聯邦基金與台灣央行利率、10 年期殖利率、零售銷售、匯率（新台幣、日圓、美元指數）、台灣進出口與 PMI 的最新值、前期、市場共識與實際值、下次公布日。
2. 查 Federal Reserve 聲明、會議紀錄、主席談話與點陣圖；BLS／FRED 原始數據。只用已公布數據，不預測未公布數字。
3. 判斷：通膨與利率方向、就業與消費強弱、風險偏好與美元資金流。
4. 傳導到台股：AI／資料中心資本支出、半導體與電子供應鏈需求、評價（殖利率對本益比）、新台幣匯率與外資流向。
5. 事件時間線：未來 2–8 週總經公布日與 FOMC，寫出每個事件的上行／下行情境。

輸出格式
• 標題：總經評論｜資料截點｜研究期間
• 結論：台股科技股總經環境「順風／中性／逆風」，一句話理由。
• 利率與通膨：數據（期間、數值、來源）、方向判斷。
• 就業與消費：數據、需求面含義。
• 對台股傳導：需求面 vs. 評價面，哪些產業最敏感（高本益比、利率敏感、內需、出口）。
• 事件時間線：日期（台北時間）、事件、可能衝擊。
• 翻轉條件：哪些數據會讓結論轉為順風或逆風。

寫作與儲存
繁體中文，數字附期間、單位、來源。區分事實、推論、未知，不捏造。說明本次相較前版改了什麼。總經數據公布後要更新本評論，個股分析會引用版本號。填入自己的 AI／模型名稱；版本衝突就重新載入整合。這是一般研究觀點，不是個人化投資建議。</pre>
									</section>
									<p id="macro-ai-status" role="status" aria-live="polite"></p>
									<form id="macro-ai-form" data-ai-action="update-macro-commentary">
										<fieldset id="macro-ai-fields" disabled>
											<label for="macro-ai-model" data-i18n="home.marketAiModel">AI / model</label>
											<input id="macro-ai-model" name="model" type="text" maxlength="120" required autocomplete="off" placeholder="AI or model name" />
											<label for="macro-ai-content">目前總經評論 · 編輯後更新</label>
											<textarea id="macro-ai-content" name="content" rows="10" maxlength="20000" required></textarea>
											<input id="macro-ai-revision" name="expectedRevision" type="hidden" value="0" />
											<div class="market-ai-actions"><button type="submit" id="macro-ai-save">更新總經評論</button><button type="button" id="macro-ai-reload" data-i18n="home.marketAiReload">Reload saved version</button></div>
										</fieldset>
									</form>
									<p data-i18n="home.marketAiLogin">Sign in to save. Your commentary and AI/model name will be publicly visible.</p>
									<p class="market-updated">API：GET／PUT <code id="macro-ai-endpoint"></code></p>
									<h5 data-i18n="home.marketAiHistory">Revision history</h5><div id="macro-ai-history"></div>
								</details>
							</section>
							<p class="macro-source-note"><span data-i18n="home.macroSources">Sources</span>: <a href="https://www.bls.gov/developers/" target="_blank" rel="noopener noreferrer">BLS</a> · <a href="https://fred.stlouisfed.org/docs/api/fred/" target="_blank" rel="noopener noreferrer">FRED</a> · <a href="https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm" target="_blank" rel="noopener noreferrer">Federal Reserve</a> · <a href="https://www.financecalendar.com/api/" target="_blank" rel="noopener noreferrer">Finance Calendar</a></p>
						</section>
						<MarketBrief brief={marketBrief} />
						<section id="market-company-events" class="market-company-events" aria-labelledby="market-company-events-title">
							<div class="market-company-events-heading"><div><h4 id="market-company-events-title" data-i18n="home.marketEventsTitle">Recent company events</h4><p data-i18n="home.marketEventsDescription">Official revenue and financial report releases, plus upcoming investor conferences.</p></div><span id="market-company-events-updated" class="market-updated" aria-live="polite" data-i18n="home.marketEventsLoading">Loading events…</span></div>
							<p class="market-company-events-sources">Sources: <a href="https://openapi.twse.com.tw/" target="_blank" rel="noopener noreferrer">TWSE OpenAPI</a> &middot; <a href="https://mops.twse.com.tw/mops/" target="_blank" rel="noopener noreferrer">MOPS</a> &middot; <a href="https://irplatform.tdcc.com.tw/ir/event/list?lang=zh" target="_blank" rel="noopener noreferrer">TDCC IR Platform</a></p>
							<div class="market-company-events-scroll"><table class="market-company-events-table"><thead><tr><th scope="col" data-i18n="home.marketEventsDate">Date</th><th scope="col" data-i18n="home.marketEventsType">Event</th><th scope="col" data-i18n="home.marketEventsInstrument">Instrument</th><th scope="col" data-i18n="home.marketEventsPeriod">Period</th></tr></thead><tbody id="market-company-events-rows"><tr><td colspan="4" class="market-updated"><span data-i18n="home.marketEventsLoadingRows">Loading selected holdings’ events…</span></td></tr></tbody></table></div>
						</section>
						<div class="market-overview-grid">
							<section id="market-watchlist" class="market-watchlist market-quote-section" aria-label="Market watchlist">
								<div class="market-watchlist-heading"><span>Instrument</span><span>Price / change</span><span>Data time</span></div>
								<button id="txf-quote-section" class="market-watch-row" type="button" aria-expanded="false" aria-controls="market-instrument-detail" data-market-symbol="TXF" aria-live="polite">
