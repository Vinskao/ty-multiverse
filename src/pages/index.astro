---
import { getCollection } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import { Icon } from '../components/Icon';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import AiTokenUsageDashboard from '../components/AiTokenUsageDashboard';
import ResearchZone from '../components/ResearchZone';
import companyProductMapping from '../storages/companyProductMapping.json';

// Page section components
import MaintainerExperience from '../components/MaintainerExperience.astro';
import HomeContact from '../components/HomeContact.astro';
import { mailtoHref } from '../scripts/contact';
import indexCssUrl from '../styles/index.css?url';
import MarketBrief from '../components/MarketBrief.astro';
import { getMarketBrief } from '../services/server/marketBrief';

// Server-rendered so AI agents that read raw HTML (no JS) still see the holdings' chip summary.
const marketBrief = await getMarketBrief();

// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// 修改服務器啟動時間的處理
let serverStartTime = new Date().toISOString();
try {
    // 使用環境變量或默認值
    serverStartTime = import.meta.env.SERVER_START_TIME || serverStartTime;
} catch (error) {
    console.error('Error getting server start time:', error);
}

// 檢查是否需要顯示登入提示
const showLoginAlert = Astro.url.searchParams.get('showLoginAlert') === 'true';


// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---
<BaseLayout
	title="免寫程式的量化研究與投資決策圖表｜TY 市場研究室"
	description="TY 市場研究室整合總經、台股籌碼、財報與研究觀點，讓不熟悉程式開發的投資人，把自己的判斷記成資料，用圖表比較市場訊號與決策條件。服務預計按使用量計費，試用與需求請以 email 聯繫。"
	canonical="https://peoplesystem.tatdvsonorth.com/tymultiverse"
	lang="zh-Hant"
>
	<Fragment slot="head">
		<link rel="stylesheet" href={indexCssUrl} />
		<link rel="alternate" type="text/markdown" href="/tymultiverse/brief.md" title="持股籌碼摘要" />
		<link rel="alternate" type="application/json" href="/tymultiverse/brief.json" title="Holdings chip summary (JSON)" />
	</Fragment>
	<!-- Messenger Chat Plugin Code -->
	<div id="fb-root"></div>

	<!-- Your Chat Plugin code -->
	<div id="fb-customer-chat" class="fb-customerchat">
	</div>
	{showLoginAlert && 
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				const lang = (window.AppLang ? window.AppLang.get() : (localStorage.getItem('site_language') || 'en'));
				const title = lang === 'zh' ? '請先登入' : 'Please Login First';
				window.Swal.fire({
					title: title,
					icon: 'info',
					timer: 1000,
					showConfirmButton: false
				});
			});
		</script>
	}
	<div class="home-page stack gap-20 lg:gap-48">

		<div class="wrapper stack gap-20 lg:gap-50">

			<header class="hero stack hero-layout">
				<div class="hero-main">
					<div class="hero-header">
						<p class="home-product-brand" data-i18n="home.productBrand">TY 市場研究室 · TY Multiverse</p>
						<h1 class="home-product-title" data-i18n="home.heroTitle">免寫程式，建立自己的市場判斷</h1>
						<p data-i18n="home.heroTagline">彙整市場資料與他人觀點，把自己的判斷記成資料，再用圖表做決策。</p>
						<p class="home-product-audience" data-i18n="home.productAudience">給想開始量化研究、卻不熟悉程式開發的人，也給想用圖像整理投資思路的一般投資人。</p>
						<div class="home-product-actions">
							<a class="home-product-contact" href={mailtoHref('trial', 'zh')} data-contact-topic="trial" data-i18n="home.productContact">寄信申請試用</a>
							<a href="#market-overview" data-i18n="home.productExplore">先看市場資料與圖表</a>
						</div>
					</div>
					<section class="home-product-intro" aria-labelledby="home-workflow-title">
						<h2 id="home-workflow-title" data-i18n="home.productWorkflow">從市場研究到決策，留下每一步的依據</h2>
						<div class="home-product-steps">
							<article><h3 data-i18n="home.productCollectTitle">彙總資料與市場觀點</h3><p data-i18n="home.productCollectBody">集中閱讀總經指標、台股籌碼、財報與產業研究，對照來源與資料日期，理解他人判斷市場的理由。</p></article>
							<article><h3 data-i18n="home.productJudgeTitle">加入自己的判斷</h3><p data-i18n="home.productJudgeBody">把觀察、理由與改變看法的條件整理成研究紀錄；資料更新時，回頭檢查自己的假設。</p></article>
							<article><h3 data-i18n="home.productDecideTitle">用圖表比較，再做決策</h3><p data-i18n="home.productDecideBody">用趨勢圖、供應鏈圖與技術路線圖交叉比較訊號，逐步建立自己的量化研究與投資決策流程。</p></article>
						</div>
						<details class="home-product-faq"><summary data-i18n="home.productFaqTitle">不會寫程式，也能開始量化研究嗎？</summary><p data-i18n="home.productFaqBody">可以先從整理有來源的資料、記錄判斷條件，以及比較圖表開始。本頁展示市場資料與研究工具；如果想把自己的研究流程搬進來，請以 email 說明需求與目前的做法。</p></details>
						<div class="home-product-pricing"><h2 data-i18n="home.productPricingTitle">預計按使用量計費</h2><p data-i18n="home.productPricingBody">希望讓不想負擔高額固定訂閱的人，也能依研究需求使用。價格與開放方式尚未公布；試用、資料整合與服務洽詢，一律以 email 聯繫。</p><a href="#contact" data-i18n="home.productPricingLink">選擇洽詢主題 ↓</a></div>
					</section>

					<section id="market-overview" class="market-overview">
						<div class="market-overview-header">
							<div>
								<h4 class="section-title" data-i18n="home.marketOverviewTitle">Market Overview</h4>
							</div>
							<p class="market-overview-note" data-i18n="home.marketOverviewNote">Refreshed every 10 minutes</p>
						</div>
						<section id="macro-dashboard" class="macro-dashboard" aria-labelledby="macro-dashboard-title" aria-live="polite">
							<div class="macro-dashboard-heading"><div><h4 id="macro-dashboard-title" data-i18n="home.macroTitle">Key macro data · U.S., Taiwan and more</h4><p data-i18n="home.macroDescription">Labor, inflation, rates, consumption, trade and FX for the U.S., Taiwan and other major economies, with upcoming release reminders.</p></div><span id="macro-dashboard-status" class="market-updated" data-i18n="home.macroLoading">Loading macro data…</span></div>
							<div id="macro-indicator-grid" class="macro-group-grid"><p class="market-updated" data-i18n="home.macroLoading">Loading macro data…</p></div>
							<div id="macro-event-list" class="macro-other-list" hidden></div>
							<section id="macro-commentary" class="market-ai-panel macro-commentary" aria-labelledby="macro-commentary-title">
								<div class="macro-commentary-heading"><h5 id="macro-commentary-title">總經評論｜所有個股分析共用</h5><span id="macro-commentary-meta" class="market-updated"></span></div>
								<div id="macro-commentary-body" class="macro-commentary-body"><p class="market-updated">載入總經評論中…</p></div>
								<details>
									<summary>更新總經評論（AI 提示、編輯、版本歷史）</summary>
									<section class="market-ai-research-prompt" aria-labelledby="macro-ai-prompt-title">
										<div class="market-ai-prompt-heading"><h5 id="macro-ai-prompt-title">總經 AI 研究提示</h5><button type="button" id="macro-ai-copy-prompt">複製完整提示</button></div>
										<pre id="macro-ai-prompt-text">你是總經研究員。這份評論是本站所有個股與期貨分析共用的總經前提，個股分析只引用、不重寫總經數據。依最新已公布資料更新下方「目前總經評論」，不得沿用前版而不重新驗證。

研究流程
1. 讀本區「多國重要總體經濟資料」與 API（GET /tymultiverse/api/market/dashboard/macro）：美國與台灣的就業／失業率、CPI／核心 CPI、PPI、聯邦基金與台灣央行利率、10 年期殖利率、零售銷售、匯率（新台幣、日圓、美元指數）、台灣進出口與 PMI 的最新值、前期、市場共識與實際值、下次公布日。
2. 查 Federal Reserve 聲明、會議紀錄、主席談話與點陣圖；BLS／FRED 原始數據。只用已公布數據，不預測未公布數字。
3. 判斷：通膨與利率方向、就業與消費強弱、風險偏好與美元資金流。
4. 傳導到台股：AI／資料中心資本支出、半導體與電子供應鏈需求、評價（殖利率對本益比）、新台幣匯率與外資流向。
5. 事件時間線：未來 2–8 週總經公布日與 FOMC，寫出每個事件的上行／下行情境。

輸出格式
• 標題：總經評論｜資料截點｜研究期間
• 結論：台股科技股總經環境「順風／中性／逆風」，一句話理由。
• 利率與通膨：數據（期間、數值、來源）、方向判斷。
• 就業與消費：數據、需求面含義。
• 對台股傳導：需求面 vs. 評價面，哪些產業最敏感（高本益比、利率敏感、內需、出口）。
• 事件時間線：日期（台北時間）、事件、可能衝擊。
• 翻轉條件：哪些數據會讓結論轉為順風或逆風。

寫作與儲存
繁體中文，數字附期間、單位、來源。區分事實、推論、未知，不捏造。說明本次相較前版改了什麼。總經數據公布後要更新本評論，個股分析會引用版本號。填入自己的 AI／模型名稱；版本衝突就重新載入整合。這是一般研究觀點，不是個人化投資建議。</pre>
									</section>
									<p id="macro-ai-status" role="status" aria-live="polite"></p>
									<form id="macro-ai-form" data-ai-action="update-macro-commentary">
										<fieldset id="macro-ai-fields" disabled>
											<label for="macro-ai-model" data-i18n="home.marketAiModel">AI / model</label>
											<input id="macro-ai-model" name="model" type="text" maxlength="120" required autocomplete="off" placeholder="AI or model name" />
											<label for="macro-ai-content">目前總經評論 · 編輯後更新</label>
											<textarea id="macro-ai-content" name="content" rows="10" maxlength="20000" required></textarea>
											<input id="macro-ai-revision" name="expectedRevision" type="hidden" value="0" />
											<div class="market-ai-actions"><button type="submit" id="macro-ai-save">更新總經評論</button><button type="button" id="macro-ai-reload" data-i18n="home.marketAiReload">Reload saved version</button></div>
										</fieldset>
									</form>
									<p data-i18n="home.marketAiLogin">Sign in to save. Your commentary and AI/model name will be publicly visible.</p>
									<p class="market-updated">API：GET／PUT <code id="macro-ai-endpoint"></code></p>
									<h5 data-i18n="home.marketAiHistory">Revision history</h5><div id="macro-ai-history"></div>
								</details>
							</section>
							<p class="macro-source-note"><span data-i18n="home.macroSources">Sources</span>: <a href="https://www.bls.gov/developers/" target="_blank" rel="noopener noreferrer">BLS</a> · <a href="https://fred.stlouisfed.org/docs/api/fred/" target="_blank" rel="noopener noreferrer">FRED</a> · <a href="https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm" target="_blank" rel="noopener noreferrer">Federal Reserve</a> · <a href="https://www.financecalendar.com/api/" target="_blank" rel="noopener noreferrer">Finance Calendar</a></p>
						</section>
						<MarketBrief brief={marketBrief} />
						<section id="market-company-events" class="market-company-events" aria-labelledby="market-company-events-title">
							<div class="market-company-events-heading"><div><h4 id="market-company-events-title" data-i18n="home.marketEventsTitle">Recent company events</h4><p data-i18n="home.marketEventsDescription">Official revenue and financial report releases, plus upcoming investor conferences.</p></div><span id="market-company-events-updated" class="market-updated" aria-live="polite" data-i18n="home.marketEventsLoading">Loading events…</span></div>
							<p class="market-company-events-sources">Sources: <a href="https://openapi.twse.com.tw/" target="_blank" rel="noopener noreferrer">TWSE OpenAPI</a> &middot; <a href="https://mops.twse.com.tw/mops/" target="_blank" rel="noopener noreferrer">MOPS</a> &middot; <a href="https://irplatform.tdcc.com.tw/ir/event/list?lang=zh" target="_blank" rel="noopener noreferrer">TDCC IR Platform</a></p>
							<div class="market-company-events-scroll"><table class="market-company-events-table"><thead><tr><th scope="col" data-i18n="home.marketEventsDate">Date</th><th scope="col" data-i18n="home.marketEventsType">Event</th><th scope="col" data-i18n="home.marketEventsInstrument">Instrument</th><th scope="col" data-i18n="home.marketEventsPeriod">Period</th></tr></thead><tbody id="market-company-events-rows"><tr><td colspan="4" class="market-updated"><span data-i18n="home.marketEventsLoadingRows">Loading selected holdings’ events…</span></td></tr></tbody></table></div>
						</section>
						<div class="market-overview-grid">
							<section id="market-watchlist" class="market-watchlist market-quote-section" aria-label="Market watchlist">
								<div id="market-automation" class="market-automation" role="status" aria-live="polite" hidden></div>
								<div class="market-watchlist-heading"><span>Instrument</span><span>Price / change</span><span>Data time</span></div>
								<button id="txf-quote-section" class="market-watch-row" type="button" aria-expanded="false" aria-controls="market-instrument-detail" data-market-symbol="TXF" aria-live="polite">
									<span class="market-watch-instrument"><strong>TXF</strong><small>TAIEX Futures · front month</small></span>
									<span class="market-watch-price"><strong id="txf-price">--</strong><small id="txf-change">--</small></span>
									<span id="txf-updated" class="market-updated">Loading...</span>
									<span id="txf-market-status" class="market-status">Loading</span>
								</button>
								<div class="market-watch-group"><h5><span data-i18n="home.marketAutomaticHoldings">All holdings · largest positions first</span> <small id="market-auto-updated"></small></h5><div id="market-auto-list" class="market-watch-list"><p class="market-updated">Waiting for a valid portfolio snapshot.</p></div></div>
								<div class="market-watch-group"><h5>Custom instruments <button id="market-custom-edit" class="mcd-edit" type="button" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z"></path></svg><span data-i18n="home.marketCustomEdit">Edit</span></button></h5><div id="market-custom-list" class="market-watch-list"><p class="market-updated">Loading...</p></div><p id="market-custom-notice" class="market-updated" role="status"></p></div>
								<dialog id="market-custom-dialog" class="market-custom-dialog" aria-labelledby="market-custom-title">
									<header class="mcd-head">
										<div>
											<h3 id="market-custom-title" data-i18n="home.marketCustomTitle">Custom instruments</h3>
											<p data-i18n="home.marketCustomSubtitle">Up to five stocks or futures, shown under the holdings.</p>
										</div>
										<form method="dialog"><button class="mcd-icon" value="cancel" aria-label="Close">×</button></form>
									</header>
									<section class="mcd-section">
										<div class="mcd-section-title"><span data-i18n="home.marketCustomSelected">Selected</span><span id="market-custom-count" class="mcd-count">0 / 5</span></div>
										<ol id="market-custom-selected" class="mcd-slots"></ol>
									</section>
									<section class="mcd-section">
										<label class="mcd-search" for="market-symbol-search">
											<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
											<input id="market-symbol-search" type="search" autocomplete="off" placeholder="Code or name, e.g. 2330 or 台積電">
										</label>
										<div class="mcd-section-title"><span id="market-search-heading" data-i18n="home.marketCustomRecent">Recently seen</span><span id="market-search-state" class="mcd-count" aria-live="polite"></span></div>
										<ul id="market-search-results" class="mcd-results" aria-live="polite"></ul>
									</section>
									<footer class="mcd-foot">
										<p id="market-custom-error" role="status"></p>
										<button id="market-custom-cancel" class="mcd-btn mcd-btn--ghost" type="button" data-i18n="home.marketCustomCancel">Cancel</button>
										<button id="market-custom-save" class="mcd-btn mcd-btn--primary" type="button" data-i18n="home.marketCustomSave" disabled>Save</button>
									</footer>
								</dialog>
							</section>
							<section id="market-chart-section" class="market-chart-section" aria-label="Selected instrument charts">
								<div id="market-instrument-detail" class="market-instrument-detail" hidden>
									<div class="market-detail-toolbar"><strong id="market-detail-title">TXF · TAIEX Futures</strong><div id="market-detail-tabs" role="tablist" aria-label="Market data"><button type="button" role="tab" aria-selected="true" data-market-tab="price" data-i18n="home.marketTabPrice">Price</button><button type="button" role="tab" aria-selected="false" data-market-tab="institutional" data-i18n="home.marketTabInstitutional">Institutional</button><button type="button" role="tab" aria-selected="false" data-market-tab="margin" data-i18n="home.marketTabMargin">Margin & lending</button><button type="button" role="tab" aria-selected="false" data-market-tab="ownership" data-i18n="home.marketTabOwnership">Ownership</button><button type="button" role="tab" aria-selected="false" data-market-tab="fundamentals" data-i18n="home.marketTabFundamentals">Fundamentals</button><button type="button" role="tab" aria-selected="false" data-market-tab="targets" data-i18n="home.marketTabTargets">Targets</button><button type="button" role="tab" aria-selected="false" data-market-tab="research" data-i18n="home.marketTabResearch">Research</button><button type="button" role="tab" aria-selected="false" data-market-tab="ai-analysis" data-i18n="home.marketTabAiAnalysis">AI analysis</button></div></div>
										<div data-market-panel="price" class="market-history-panel"><p id="market-history-status" class="market-updated" aria-live="polite" data-i18n="home.marketHistorySelectStock">Select a stock to load daily history.</p><div id="market-history-price-chart"></div></div>
										<div data-market-panel="institutional" class="market-history-panel" hidden><h4 data-i18n="home.marketTabInstitutional">Institutional</h4><p id="market-history-institutional-description" class="market-updated" data-i18n="home.marketHistoryInstitutionalDescription">Foreign and investment trust net trading · shares; hover bars for date and values.</p><div id="market-history-institutional-chart"></div><div id="market-history-open-interest" hidden><h5 data-i18n="home.marketHistoryOpenInterestTitle">Net open interest (contracts)</h5><p id="market-history-open-interest-summary" class="market-updated" aria-live="polite"></p><div id="market-history-open-interest-chart"></div></div></div>
										<div data-market-panel="margin" class="market-history-panel" hidden><h4 data-i18n="home.marketTabMargin">Margin & lending</h4><p class="market-updated" data-i18n="home.marketHistoryMarginDescription">Hover charts for daily figures. Margin and short balances use lots; borrowed stock sold uses shares.</p><h5 data-i18n="home.marketHistoryMarginBalance">Margin and short balances</h5><div id="market-history-margin-chart"></div><h5 data-i18n="home.marketHistoryMarginFlow">Margin and short activity</h5><div id="market-history-margin-flow-chart"></div><h5 data-i18n="home.marketHistoryBorrowBalance">Borrowed stock sold balance</h5><div id="market-history-borrow-chart"></div><h5 data-i18n="home.marketHistoryBorrowFlow">Borrow sales and returns</h5><div id="market-history-borrow-flow-chart"></div></div>
