---
import { getCollection } from 'astro:content';
import algorithmsData from '../storages/algorithmsUsed.json';
import skillsData from '../storages/skills.json';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import { Icon } from '../components/Icon';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import SkillsBubbleChart from '../components/SkillsBubbleChart';
import AiTokenUsageDashboard from '../components/AiTokenUsageDashboard';
import ResearchZone from '../components/ResearchZone';
import companyProductMapping from '../storages/companyProductMapping.json';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';
import indexCssUrl from '../styles/index.css?url';
import MarketBrief from '../components/MarketBrief.astro';
import { getMarketBrief } from '../services/server/marketBrief';

// Server-rendered so AI agents that read raw HTML (no JS) still see the holdings' chip summary.
const marketBrief = await getMarketBrief();

// 準備 Bubble Chart 資料 - 從 skillsData 計算每個類別的總分
const shadeScores: { [key: string]: number } = {
	shade1: 5,
	shade2: 4,
	shade3: 3,
	shade4: 2,
	shade5: 1,
};

interface BubbleData {
	id: string;
	name: string;
	value: number;
	category: string;
}

const bubbleChartData: BubbleData[] = skillsData.categories.map((category: any) => {
	// Flatten skills from subcategories if they exist, otherwise use direct skills
	const allSkills = category.subcategories 
		? category.subcategories.flatMap((sub: any) => sub.skills)
		: category.skills || [];
	
	// Calculate total score for the category
	const totalScore = allSkills.reduce((sum: number, skill: any) => {
		return sum + (shadeScores[skill.level] || 0);
	}, 0);

	return {
		id: category.name,
		name: category.name,
		value: totalScore,
		category: category.name,
	};
});
// Content Fetching: List four most recent work projects
const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// 修改服務器啟動時間的處理
let serverStartTime = new Date().toISOString();
try {
    // 使用環境變量或默認值
    serverStartTime = import.meta.env.SERVER_START_TIME || serverStartTime;
} catch (error) {
    console.error('Error getting server start time:', error);
}

// 檢查是否需要顯示登入提示
const showLoginAlert = Astro.url.searchParams.get('showLoginAlert') === 'true';

const algorithmsUsed = algorithmsData.algorithms;
const skillsCategories = skillsData.categories;

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---
<BaseLayout>
	<Fragment slot="head">
		<link rel="stylesheet" href={indexCssUrl} />
		<link rel="alternate" type="text/markdown" href="/tymultiverse/brief.md" title="持股籌碼摘要" />
		<link rel="alternate" type="application/json" href="/tymultiverse/brief.json" title="Holdings chip summary (JSON)" />
	</Fragment>
	<!-- Messenger Chat Plugin Code -->
	<div id="fb-root"></div>

	<!-- Your Chat Plugin code -->
	<div id="fb-customer-chat" class="fb-customerchat">
	</div>
	{showLoginAlert && 
		<script is:inline>
			document.addEventListener('DOMContentLoaded', function() {
				const lang = (window.AppLang ? window.AppLang.get() : (localStorage.getItem('site_language') || 'en'));
				const title = lang === 'zh' ? '請先登入' : 'Please Login First';
				window.Swal.fire({
					title: title,
					icon: 'info',
					timer: 1000,
					showConfirmButton: false
				});
			});
		</script>
	}
	<div class="stack gap-20 lg:gap-48">

		<div class="wrapper stack gap-20 lg:gap-50">

			<header class="hero stack hero-layout">
				<div class="hero-main">
					<div class="hero-header">
						<h1 data-i18n="home.heroTitle">TY's Outerspace</h1>
						<p data-i18n="home.heroTagline">Java Backend Engineer | Enterprise Systems | Security Integration | AI/RAG Applications</p>
						<div class="visitor-counter-box">
						<p class="visit-counter"><span data-i18n="home.visitorCounterPrefix">Sequence #</span><span id="visit-count">...</span><span data-i18n="home.visitorCounterSuffix">: Identity Synchronized</span></p>
						</div>
					</div>

					<section id="market-overview" class="market-overview">
						<div class="market-overview-header">
							<div>
								<h4 class="section-title" data-i18n="home.marketOverviewTitle">Market Overview</h4>
							</div>
							<p class="market-overview-note" data-i18n="home.marketOverviewNote">Refreshed every 10 minutes</p>
						</div>
						<MarketBrief brief={marketBrief} />
						<div class="market-overview-grid">
							<section id="market-watchlist" class="market-watchlist market-quote-section" aria-label="Market watchlist">
								<div class="market-watchlist-heading"><span>Instrument</span><span>Price / change</span><span>Data time</span></div>
								<button id="txf-quote-section" class="market-watch-row" type="button" aria-expanded="false" aria-controls="market-instrument-detail" data-market-symbol="TXF" aria-live="polite">
									<span class="market-watch-instrument"><strong>TXF</strong><small>TAIEX Futures · front month</small></span>
									<span class="market-watch-price"><strong id="txf-price">--</strong><small id="txf-change">--</small></span>
									<span id="txf-updated" class="market-updated">Loading...</span>
									<span id="txf-market-status" class="market-status">Loading</span>
								</button>
								<div class="market-watch-group"><h5>Automatic top five holdings <small id="market-auto-updated"></small></h5><div id="market-auto-list" class="market-watch-list"><p class="market-updated">Waiting for a valid portfolio snapshot.</p></div></div>
								<div class="market-watch-group"><h5>Custom instruments <button id="market-custom-edit" type="button" hidden>Edit</button></h5><div id="market-custom-list" class="market-watch-list"><p class="market-updated">Loading...</p></div></div>
								<dialog id="market-custom-dialog" class="market-custom-dialog"><form method="dialog"><div class="market-dialog-heading"><h3>Custom instruments</h3><button value="cancel" aria-label="Close">×</button></div></form><label for="market-symbol-search">Search stock or futures code / name</label><div class="market-search-row"><input id="market-symbol-search" type="search" autocomplete="off" placeholder="2330 or TSMC"><button id="market-search-submit" type="button">Search</button></div><div id="market-search-results" class="market-search-results" aria-live="polite"></div><h4>Historical candidates</h4><label for="market-candidate-search">Filter previously seen contracts</label><input id="market-candidate-search" type="search" autocomplete="off" placeholder="code or name"><div id="market-candidate-results" class="market-search-results" aria-live="polite"></div><h4>Selected <span id="market-custom-count">0 / 5</span></h4><div id="market-custom-selected" class="market-search-results"></div><p id="market-custom-error" role="status"></p><div class="market-dialog-actions"><button id="market-custom-save" type="button">Save</button><button id="market-custom-cancel" type="button">Cancel</button></div></dialog>
							</section>
							<section id="market-chart-section" class="market-chart-section" aria-label="Selected instrument charts">
								<div id="market-instrument-detail" class="market-instrument-detail" hidden>
									<div class="market-detail-toolbar"><strong id="market-detail-title">TXF · TAIEX Futures</strong><div id="market-detail-tabs" role="tablist" aria-label="Market data"><button type="button" role="tab" aria-selected="true" data-market-tab="price" data-i18n="home.marketTabPrice">Price</button><button type="button" role="tab" aria-selected="false" data-market-tab="institutional" data-i18n="home.marketTabInstitutional">Institutional</button><button type="button" role="tab" aria-selected="false" data-market-tab="margin" data-i18n="home.marketTabMargin">Margin & lending</button><button type="button" role="tab" aria-selected="false" data-market-tab="ownership" data-i18n="home.marketTabOwnership">Ownership</button><button type="button" role="tab" aria-selected="false" data-market-tab="fundamentals" data-i18n="home.marketTabFundamentals">Fundamentals</button></div></div>
										<div data-market-panel="price" class="market-history-panel"><p id="market-history-status" class="market-updated" aria-live="polite" data-i18n="home.marketHistorySelectStock">Select a stock to load daily history.</p><div id="market-history-price-chart"></div></div>
										<div data-market-panel="institutional" class="market-history-panel" hidden><h4 data-i18n="home.marketTabInstitutional">Institutional</h4><p id="market-history-institutional-description" class="market-updated" data-i18n="home.marketHistoryInstitutionalDescription">Foreign and investment trust net trading · shares; hover bars for date and values.</p><div id="market-history-institutional-chart"></div></div>
										<div data-market-panel="margin" class="market-history-panel" hidden><h4 data-i18n="home.marketTabMargin">Margin & lending</h4><p class="market-updated" data-i18n="home.marketHistoryMarginDescription">Hover charts for daily figures. Margin and short balances use lots; borrowed stock sold uses shares.</p><h5 data-i18n="home.marketHistoryMarginBalance">Margin and short balances</h5><div id="market-history-margin-chart"></div><h5 data-i18n="home.marketHistoryMarginFlow">Margin and short activity</h5><div id="market-history-margin-flow-chart"></div><h5 data-i18n="home.marketHistoryBorrowBalance">Borrowed stock sold balance</h5><div id="market-history-borrow-chart"></div><h5 data-i18n="home.marketHistoryBorrowFlow">Borrow sales and returns</h5><div id="market-history-borrow-flow-chart"></div></div>
										<div data-market-panel="ownership" class="market-history-panel" hidden><h4 data-i18n="home.marketTabOwnership">Ownership distribution</h4><h5 data-i18n="home.marketHistoryForeignHoldingTitle">Foreign shareholding</h5><p class="market-updated" data-i18n="home.marketHistoryOwnershipHoverGuide">Hover each chart for its date and value.</p><div id="market-history-foreign-holding-chart"></div><div id="market-history-foreign-holding-shares-chart"></div><h5 data-i18n="home.marketHistoryOwnershipDescription">Select a TDCC tier and hover its weekly chart.</h5><div id="market-history-ownership"></div></div>
										<div data-market-panel="fundamentals" class="market-history-panel" hidden><h4 data-i18n="home.marketTabFundamentals">Fundamentals</h4><p id="market-fundamentals-status" class="market-updated" aria-live="polite">Select a stock to load revenue and financial statements.</p><h5 data-i18n="home.marketFundamentalsRevenue">Monthly revenue growth · YoY / MoM</h5><div id="market-fundamentals-revenue-chart"></div><h5 data-i18n="home.marketFundamentalsStatements">Profitability · margins and their changes</h5><div id="market-fundamentals-statements"></div><h5 data-i18n="home.marketFundamentalsBalance">Financial structure ratios</h5><div id="market-fundamentals-balance"></div><h5 data-i18n="home.marketFundamentalsCashFlow">Cash flow ratios</h5><div id="market-fundamentals-cash-flow"></div><p id="market-fundamentals-source" class="market-updated"></p></div>
								</div>
								<div id="market-chart-placeholder" class="market-chart-placeholder">Select a holding to view its price and institutional charts.</div>
							</section>
							<section id="market-usage-section" class="market-usage-section" aria-live="polite">
								<div class="market-quote-heading"><div><h5 class="section-title" data-i18n="home.marketUsageTitle">Usage</h5></div><span id="market-usage-status" class="market-status">Loading</span></div>
								<div class="market-usage-card"><div class="market-usage-hero"><strong id="market-usage-used">--</strong><span id="market-usage-limit">--</span></div><div class="market-usage-progress"><div id="market-usage-progress-bar"></div></div><dl class="market-metrics"><div><dt data-i18n="home.marketUsageRemaining">Remaining</dt><dd id="market-usage-remaining">--</dd></div><div><dt data-i18n="home.marketUsageConnections">Connections</dt><dd id="market-usage-connections">--</dd></div><div><dt data-i18n="home.marketUsageUpdated">Updated</dt><dd id="market-usage-updated">--</dd></div></dl></div>
							</section>
							<section id="portfolio-section" class="market-usage-section portfolio-section" aria-live="polite">
								<div class="market-quote-heading">
									<div>
										<h5 class="section-title">Account Portfolio</h5>
									</div>
									<span id="portfolio-status" class="market-status">Loading</span>
								</div>
								<div class="market-usage-card portfolio-card">
									<div class="portfolio-summary">
										<div class="portfolio-summary-item">
											<span>Cash balance</span>
											<strong id="portfolio-cash" tabindex="0">--</strong>
											<small id="portfolio-cash-split" class="portfolio-region-split" hidden></small>
											<div id="portfolio-cash-tooltip" class="portfolio-summary-tooltip" role="status"></div>
										</div>
										<div class="portfolio-summary-item">
											<span>Estimated total assets</span>
											<strong id="portfolio-total" tabindex="0">--</strong>
											<small id="portfolio-total-split" class="portfolio-region-split" hidden></small>
											<div id="portfolio-total-tooltip" class="portfolio-summary-tooltip" role="status"></div>
										</div>
										<div class="portfolio-summary-item">
											<span>Total unrealized P/L</span>
											<strong id="portfolio-pnl" tabindex="0">--</strong>
											<div id="portfolio-pnl-tooltip" class="portfolio-summary-tooltip" role="status"></div>
									</div>
									<div class="portfolio-summary-item">
											<span id="portfolio-leverage-label" data-i18n="home.portfolioLeverageTaiwan">Taiwan leverage</span>
											<strong id="portfolio-leverage" tabindex="0">--</strong>
											{/* Overseas leverage split paused.
											<small id="portfolio-leverage-split" class="portfolio-region-split" hidden>
												<span data-i18n="home.portfolioRegionTaiwan">Taiwan</span> <b id="portfolio-leverage-taiwan">--</b>
												<span aria-hidden="true"> · </span>
												<span data-i18n="home.portfolioRegionOverseas">Overseas</span> <b id="portfolio-leverage-overseas">--</b>
											</small>
											*/}
											<small id="portfolio-leverage-formula" class="portfolio-leverage-formula" data-i18n="home.leverageFormulaTaiwan">Taiwan: (futures exposure + stock value + cash) ÷ Taiwan assets</small>
											<div id="portfolio-leverage-tooltip" class="portfolio-summary-tooltip" role="status"></div>
										</div>
									</div>
									<p id="portfolio-updated" class="market-updated">--</p>
									<p id="portfolio-access-message" class="market-updated" hidden></p>
								</div>
							</section>
						</div>

					<!-- Donut charts: full market-overview-grid width -->
					<div class="portfolio-donuts-fullwidth">
						<!-- 台灣 region: Securities + Futures -->
						<span class="portfolio-region-label" data-i18n="home.portfolioRegionTaiwan">台灣 Taiwan</span>
						<div class="portfolio-donuts-row">
							<div class="portfolio-donut-section">
								<span class="portfolio-donut-label">Securities</span>
								<div id="portfolio-allocation-chart" class="portfolio-donut portfolio-donut--sm" aria-label="Stock allocation">
									<svg id="portfolio-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Stock allocation chart"></svg>
									<div class="portfolio-donut-center">
										<strong id="portfolio-position-count">--</strong>
									</div>
									<div id="portfolio-tooltip" class="portfolio-tooltip" role="status"></div>
								</div>
								<span id="portfolio-securities-value" class="portfolio-donut-sub-value">--</span>
							</div>
							<div class="portfolio-donut-section">
								<span class="portfolio-donut-label">Futures</span>
								<div id="portfolio-futures-chart" class="portfolio-donut portfolio-donut--sm" aria-label="Futures allocation">
									<svg id="portfolio-futures-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Futures allocation chart"></svg>
									<div class="portfolio-donut-center">
										<strong id="portfolio-futures-count">--</strong>
									</div>
									<div id="portfolio-futures-tooltip" class="portfolio-tooltip" role="status"></div>
								</div>
								<span id="portfolio-futures-equity" class="portfolio-donut-sub-value">--</span>
							</div>
						</div>

						{/* Overseas and combined views are paused; retain markup for reactivation.

						<span class="portfolio-region-label" data-i18n="home.portfolioRegionOverseas">海外 Overseas</span>
						<div class="portfolio-donut-section" id="portfolio-overseas-section" hidden>
							<span class="portfolio-donut-label">ASSETS</span>
							<div id="portfolio-overseas-chart" class="portfolio-donut portfolio-donut--sm" aria-label="Overseas allocation">
								<svg id="portfolio-overseas-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Overseas allocation chart"></svg>
								<div class="portfolio-donut-center">
									<strong id="portfolio-overseas-count">--</strong>
								</div>
								<div id="portfolio-overseas-tooltip" class="portfolio-tooltip" role="status"></div>
							</div>
							<span id="portfolio-overseas-value" class="portfolio-donut-sub-value">--</span>
						</div>


						<span class="portfolio-region-label" data-i18n="home.portfolioRegionCombined">Combined</span>
						<div class="portfolio-donuts-row portfolio-donuts-row--combined">
							<div class="portfolio-donut-section">
								<span class="portfolio-donut-label" data-i18n="home.portfolioRegionTaiwan">台灣 Taiwan</span>
								<div class="portfolio-donut portfolio-donut--sm" aria-label="Taiwan combined allocation">
									<svg id="portfolio-combined-tw-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Taiwan combined chart"></svg>
									<div class="portfolio-donut-center">
										<strong id="portfolio-combined-tw-count">--</strong>
									</div>
									<div id="portfolio-combined-tw-tooltip" class="portfolio-tooltip" role="status"></div>
								</div>
							</div>
							<div class="portfolio-donut-section" id="portfolio-combined-os-wrap" hidden>
								<span class="portfolio-donut-label" data-i18n="home.portfolioRegionOverseas">海外 Overseas</span>
								<div class="portfolio-donut portfolio-donut--sm" aria-label="Overseas combined allocation">
									<svg id="portfolio-combined-os-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Overseas combined chart"></svg>
									<div class="portfolio-donut-center">
										<strong id="portfolio-combined-os-count">--</strong>
									</div>
									<div id="portfolio-combined-os-tooltip" class="portfolio-tooltip" role="status"></div>
								</div>
							</div>
							<div class="portfolio-donut-section">
								<span class="portfolio-donut-label" data-i18n="home.portfolioRegionAll">全部 All</span>
								<div id="portfolio-combined-chart" class="portfolio-donut portfolio-donut--sm" aria-label="Combined allocation">
									<svg id="portfolio-combined-donut-svg" viewBox="0 0 120 120" role="img" aria-label="Combined allocation chart"></svg>
									<div class="portfolio-donut-center">
										<strong id="portfolio-combined-count">--</strong>
									</div>
									<div id="portfolio-combined-tooltip" class="portfolio-tooltip" role="status"></div>
								</div>
							</div>
						</div>
						*/}
						<p class="portfolio-chart-hint">Hover, focus, or tap a slice for position details.</p>
					</div>
					<section id="portfolio-history-section" class="portfolio-history" aria-live="polite" aria-labelledby="portfolio-history-title">
						<div class="portfolio-history-heading">
							<div>
								<h5 id="portfolio-history-title" class="section-title" data-i18n="home.portfolioHistoryTitle">Daily portfolio value</h5>
								<p data-i18n="home.portfolioHistoryDescription">Taiwan estimated total assets · daily closing snapshot</p>
							</div>
							<span id="portfolio-history-status" class="portfolio-history-status">Loading</span>
						</div>
						<div id="portfolio-history-chart" class="portfolio-history-chart">
							<p id="portfolio-history-empty" class="portfolio-history-empty" data-i18n="home.portfolioHistoryLoading">Loading daily history…</p>
							<svg id="portfolio-history-svg" class="is-hidden" viewBox="0 0 900 280" role="img" aria-label="Daily Taiwan portfolio total asset trend"></svg>
						</div>
					</section>
					</section>

				</div>

				<div class="hero-side">

					<div class="video-container">
						<div class="roles">
							<Pill class="gold"><Icon icon="code" size="1.33em" /> Backend</Pill>
							<Pill class="gold"><Icon icon="pencil-line" size="1.33em" /> DevOps</Pill>
							<Pill><Icon icon="code" size="1.33em" /> Frontend</Pill>
							<Pill><Icon icon="microphone-stage" size="1.33em" /> PM</Pill>
						</div>
						<div class="github-graph">
							<h5 class="section-title" data-i18n="home.githubTitle">Github Contributions</h5>
							<div>
								<img src="https://ghchart.rshah.org/VinsKao" alt="VinsKao's Github chart" />
							</div>
						</div>

						<div class="leetcode-graph">
							<h5 class="section-title" data-i18n="home.leetcodeTitle">LeetCode Stats</h5>
							<div id="leetcode-stats" class="leetcode-container">
								<div class="leetcode-card">
									<h6 data-i18n="home.leetcodeLabels.solved">Total Solved</h6>
									<p id="total-solved" data-i18n="home.loading">Loading...</p>
									<div class="progress-bar">
										<div id="total-progress"></div>
									</div>
								</div>
								<div class="leetcode-card">
									<h6 data-i18n="home.leetcodeLabels.easy">Easy</h6>
									<p id="easy-solved" data-i18n="home.loading">Loading...</p>
									<div class="progress-bar">
										<div id="easy-progress"></div>
									</div>
								</div>
								<div class="leetcode-card">
									<h6 data-i18n="home.leetcodeLabels.medium">Medium</h6>
									<p id="medium-solved" data-i18n="home.loading">Loading...</p>
									<div class="progress-bar">
										<div id="medium-progress"></div>
									</div>
								</div>
								<div class="leetcode-card">
									<h6 data-i18n="home.leetcodeLabels.hard">Hard</h6>
									<p id="hard-solved" data-i18n="home.loading">Loading...</p>
									<div class="progress-bar">
										<div id="hard-progress"></div>
									</div>
								</div>
							</div>
						</div>

						<div class="algorithms-section">
							<h5 class="section-title" data-i18n="home.patternsTitle">Patterns Learned</h5>
							<div class="algorithms-list">
								{algorithmsUsed.map((algo) => (
									<span class="algo-pill" data-explanation={algo.explanation}>{algo.name}</span>
								))}
							</div>
						</div>

						<div class="portrait-container">

						</div>

					</div>
				</div>

				
				<div class="ai-usage-home-section ai-usage-home-section--fullwidth">
					<AiTokenUsageDashboard client:load />
				</div>
			</header>

			<!-- Skills Bubble Chart: full-width -->
			<div class="wrapper">
				<SkillsBubbleChart client:load data={bubbleChartData} categoriesData={skillsCategories} />
			</div>

			<!-- Skills Overview: full-width above Research Zone -->
			<div class="wrapper categories-section">
				<div class="categories">
					{skillsCategories.map((category) => {
						return (
							<div class="category">
								<h5 class="section-title">{category.name}</h5>
								{(category as any).subcategories ? (
									(category as any).subcategories.map((sub: any) => (
										<div class="subcategory-group">
											<span class="subcategory-label">{sub.name}</span>
											<div class="pills-container">
												{sub.skills.map((skill: any) => (
													<span class={`skill-pill ${category.pillClass} ${skill.level} ${skill.specialClass || ''}`}>
														{skill.name}
													</span>
												))}
											</div>
										</div>
									))
								) : (
									<div class="pills-container">
										{((category as any).skills || []).map((skill: any) => (
											<span class={`skill-pill ${category.pillClass} ${skill.level} ${skill.specialClass || ''}`}>
												{skill.name}
											</span>
										))}
									</div>
								)}
							</div>
						);
					})}
				</div>
			</div>

			<Skills />

			<!-- Research Zone: accordion of research components -->
			<section class="research-zone-wrapper wrapper">
				<h4 class="section-title" data-i18n="home.researchZoneTitle">Research Zone</h4>
				<ResearchZone client:visible mappingData={companyProductMapping} />
			</section>

		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h5 class="section-title" data-i18n="home.collectionsTitle">Collections</h5>
					<p data-i18n="home.recentNotes">Recent Notes</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((project) => (
								<li>
									<PortfolioPreview project={project} />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/tymultiverse/work/">
						<span data-i18n="home.viewAll">View All</span>
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			<section class="section with-background bg-variant">
				<header class="section-header stack gap-2 lg:gap-4">
					<!-- <h5>Mentions</h5>
					<p>
						To be Continued...
					</p> -->
				</header>

				<!-- <div class="gallery">
					<Grid variant="small">
						{
							['Who', 'Am', 'I'].map((brand) => (
								<li class="mention-card">
									<p>{brand}</p>
								</li>
							))
						}
					</Grid>
				</div> -->
			</section>
		</main>

		<ContactCTA />
	</div>
	<script src="../scripts/index.ts"></script>
</BaseLayout>
