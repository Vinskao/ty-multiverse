---
import BaseLayout from "../layouts/BaseLayout.astro";
import { learnCatalog } from "../scripts/learn/catalog";
import HomeAdPlacements from "../components/HomeAdPlacements.astro";

---

<BaseLayout title="學習中心與多益練習 | TY 市場研究室" description="依主題探索學習內容，進行多益練習並回顧作答紀錄。" lang="zh-TW">
  <div class="learn-shell">
    <aside class="learn-sidebar" aria-label="主題">
      <p class="learn-meta">LEARN</p>
      <button id="learn-home" class="learn-home-link" type="button">← 學習中心</button>
      <nav class="learn-subject-menu" aria-label="學習領域">
        {learnCatalog.map(subject => <div class="learn-sidebar-section">
          <button type="button" class="learn-topic learn-subject-button" data-subject-id={subject.id}>{subject.title}</button>
          {subject.id === 'english' && <nav id="learn-topics" class="learn-topics" data-submenu="english" aria-label="多益題目" hidden>載入中…</nav>}
          {subject.id === 'macroeconomics' && <button id="learn-maya-open" class="learn-topic learn-topic-link" data-submenu="macroeconomics" type="button" hidden>市場快報｜主播精讀</button>}
          {subject.id === 'microeconomics' && <button type="button" class="learn-topic learn-topic-link" data-submenu="microeconomics" data-subject-id="microeconomics" data-course-id="semiconductor" hidden>半導體</button>}
        </div>)}
      </nav>
      <button id="learn-mentor-open" class="learn-mentor-link" type="button" hidden>導師模式：全班作答狀況</button>
      <section class="learn-history" aria-labelledby="history-title">
        <h3 id="history-title">最近作答</h3>
        <div id="learn-history-content">尚無紀錄</div>
      </section>
    </aside>

    <main class="learn-main">
      <HomeAdPlacements compact />
      <!-- 主題總覽：尚未進入任何主題時顯示 -->
      <section id="learn-overview" class="learn-overview">
        <header class="learn-overview-header">
          <p class="learn-eyebrow">TY MULTIVERSE / LEARNING</p>
          <h1>學習中心</h1>
          <p>從英文到經濟與工程，依主題建立知識。多益練習已開放，其餘先規劃考試範圍。</p>
        </header>
        <div class="learn-catalog-video" aria-hidden="true">
          <video src="https://tymultiverse.cc/images/people/walking.mp4" autoplay muted playsinline preload="auto" disablepictureinpicture tabindex="-1"></video>
          <video src="https://tymultiverse.cc/images/people/hiking.mp4" muted playsinline preload="auto" disablepictureinpicture tabindex="-1"></video>
        </div>
        <div class="learn-catalog-heading"><h2>探索學習領域</h2><span>課程與考試主題</span></div>
        <div class="learn-catalog">
          {learnCatalog.map((subject, index) => <section class="learn-subject" data-catalog-subject={subject.id} aria-labelledby={`subject-${subject.id}`}>
            <div class="learn-subject-head"><span class="learn-subject-number">0{index + 1}</span><span class="learn-subject-state">{subject.id === 'english' ? '可練習' : '規劃中'}</span></div>
            <h3 id={`subject-${subject.id}`}>{subject.title}</h3><p class="learn-subject-intro">{subject.subtitle}</p>
            <ul class="learn-course-list">
              {subject.courses.map(course => <li class="learn-course" data-catalog-course={course.id}>
                <div><strong>{course.title}</strong><p>{course.topics.join(' · ')}</p></div>
                {course.status === 'available' ? <a href={course.source} data-learn-toeic>開始練習 <span aria-hidden="true">↗</span></a> : <a href={course.source}>參考資料 <span aria-hidden="true">↗</span></a>}
              </li>)}
            </ul>
          </section>)}
        </div>

      </section>

      <!-- 作答階段：只有題目，沒有任何答案或歷史數據 -->
      <section id="learn-audio" class="learn-phase learn-audio-view" hidden>
        <header class="learn-header market-audio-header"><div><p class="learn-eyebrow">MARKET BRIEFING</p><h1 id="market-audio-heading">每日市場精讀</h1><p class="learn-meta" id="market-audio-description">每日市場分析語音</p></div></header>
        <section class="learn-catalog" aria-labelledby="market-audio-title">
          <div class="learn-catalog-heading"><h2 id="market-audio-title">市場快報｜主播精讀</h2><span>完整語音</span></div>
          <div id="market-audio-list" aria-live="polite"><p>載入已完成的市場快報…</p></div>
        </section>
      </section>

      <section id="learn-answering" class="learn-phase" hidden>
        <header class="learn-header">
          <div>
            <p class="learn-meta"><span class="learn-phase-tag">作答中</span> <span id="answering-resumed"></span></p>
            <h1 id="answering-title">—</h1>
            <p id="answering-description" class="learn-meta"></p>
          </div>
          <div class="learn-timer" id="learn-timer" aria-live="polite">00:00</div>
        </header>

        <div class="learn-progress" aria-live="polite">
          <div class="learn-progress-bar"><span id="learn-progress-fill"></span></div>
          <span id="learn-progress-label">0 / 0</span>
        </div>

        <form id="learn-form">
          <div id="learn-questions"></div>
          <div class="learn-actions">
            <button id="learn-submit" type="submit" disabled>全部作答完才能送出</button>
            <span id="learn-notice" class="learn-notice" aria-live="polite"></span>
          </div>
        </form>
      </section>

      <!-- 檢討階段：正解、逐選項解析、累計答錯次數 -->
      <section id="learn-review" class="learn-phase" hidden>
        <header class="learn-header">
          <div>
            <p class="learn-meta"><span class="learn-phase-tag review">檢討中</span></p>
            <h1 id="review-title">—</h1>
            <p id="review-summary" class="learn-meta"></p>
          </div>
          <div class="learn-review-actions">
            <button id="review-scorecard" type="button" class="ghost">累計成績單</button>
            <button id="review-restart" type="button">再寫一輪</button>
          </div>
        </header>
        <!-- 排行榜：檢討模式下才看得到其他人的平均作答狀況 -->
        <section id="learn-ranking" class="learn-ranking" hidden></section>
        <div id="learn-review-body"></div>
      </section>

      <!-- 導師模式：所有帳號的作答狀況 -->
      <section id="learn-mentor" class="learn-phase" hidden>
        <header class="learn-header">
          <div>
            <p class="learn-meta"><span class="learn-phase-tag mentor">導師模式</span></p>
            <h1>全班作答狀況</h1>
            <p id="mentor-summary" class="learn-meta"></p>
          </div>
          <button id="mentor-refresh" type="button" class="ghost">重新整理</button>
        </header>
        <div id="learn-mentor-body"></div>
      </section>

      <!-- 累計成績單 -->
      <section id="learn-scorecard" class="learn-phase" hidden>
        <header class="learn-header">
          <div>
            <p class="learn-meta"><span class="learn-phase-tag">累計成績單</span></p>
            <h1 id="scorecard-title">—</h1>
            <p id="scorecard-summary" class="learn-meta"></p>
          </div>
          <button id="scorecard-back" type="button" class="ghost">返回</button>
        </header>
        <div id="learn-scorecard-body"></div>
      </section>

      <p id="learn-status" class="learn-status" hidden></p>
    </main>
    <div class="wrapper"><HomeAdPlacements /></div>
  </div>
</BaseLayout>

<script>
  import { keepCatalogVideoPlaying, discoverNumberedClips, clipExists } from "../scripts/learn/catalogVideo";
  document.addEventListener("astro:page-load", () => {
    const playlist = keepCatalogVideoPlaying();
    // walking2.mp4, walking3.mp4 ... join the playlist automatically as they are uploaded
    if (playlist) void discoverNumberedClips(clipExists).then(urls => urls.forEach(url => playlist.add(url)));
  });
</script>

<script>
  import { marketAudioDateTime, marketAudioDay, latestTestAudioRevisions, newestMarketAudioFirst } from '../scripts/learn/marketAudioPresentation';
  import { presenterForAudio, dailyReadingTitle } from '../scripts/learn/presenterSchedule';
  import { bindMarketAudioPlayback } from '../scripts/learn/marketAudioPlayback';
  import { applyMarketPresenterSettings } from '../scripts/learn/marketPresenterConfig';
  import { canShowFullPresenter } from '../scripts/learn/presenterAccess';
  import { GATEWAY_API_BASE } from '../common/constants/api';
  type AudioItem = { productType: 'macro' | 'stock' | 'daily'; code: string; revision: number; createdAt?: string; day?: string; voice?: string; presenterName?: string };
  const language = () => window.AppLang?.get?.() === 'zh' ? 'zh' : 'en';
  let presenterAccessVersion = 0;
  async function updatePresenterAccess() {
    const version = ++presenterAccessVersion;
    const token = localStorage.getItem('token');
    document.querySelectorAll<HTMLElement>('.presenter-frame').forEach(frame => { frame.dataset.full = 'false'; });
    const allowed = await canShowFullPresenter(token, fetch, GATEWAY_API_BASE);
    if (version !== presenterAccessVersion || token !== localStorage.getItem('token')) return;
    document.querySelectorAll<HTMLElement>('.presenter-frame').forEach(frame => { frame.dataset.full = allowed ? 'true' : 'false'; });
  }
  document.addEventListener('tym:auth-changed', updatePresenterAccess);
  window.addEventListener('storage', event => { if (event.key === 'token') void updatePresenterAccess(); });
  function localizeMarketAudio() {
    const zh = language() === 'zh';
    const heading = document.querySelector<HTMLElement>('#market-audio-heading');
    const description = document.querySelector<HTMLElement>('#market-audio-description');
    const catalogTitle = document.querySelector<HTMLElement>('#market-audio-title');
    const catalogType = document.querySelector<HTMLElement>('.learn-audio-view .learn-catalog-heading span');
    if (heading) heading.textContent = zh ? '每日市場精讀' : 'Daily Market Reading';
    if (description) description.textContent = zh ? '每日市場分析語音' : 'Daily market analysis audio';
    if (catalogTitle) catalogTitle.textContent = zh ? '市場快報｜主播精讀' : 'Market Briefing | Daily Reading';
    if (catalogType) catalogType.textContent = zh ? '完整語音' : 'Full audio';
    document.querySelectorAll<HTMLElement>('.market-audio-date').forEach(node => {
      const value = marketAudioDay(node.dataset.day, language()) ?? marketAudioDateTime(node.dataset.createdAt, language());
      node.textContent = value ?? '';
      node.hidden = !value;
    });
    document.querySelectorAll<HTMLElement>('.market-audio-card-title').forEach(node => {
      const type = node.dataset.productType;
      node.textContent = type === 'daily'
        ? `${node.dataset.presenterName || 'Maya'} ${node.dataset.test === 'true' ? (zh ? '試音' : 'Voice Test') : (zh ? '每日精讀' : 'Daily Reading')}`
        : type === 'macro' ? (zh ? '總經' : 'Macro') : (zh ? '個股' : 'Stock');
      if (node.dataset.mayaPending === 'true') node.textContent += zh ? '（Uiobbeci 市場分析，Maya 待定）' : ' (Uiobbeci market analysis; Maya pending)';
    });
  }
  window.AppLang?.onChange?.(localizeMarketAudio);
  function loadMarketAudio() {
    const list = document.querySelector<HTMLElement>('#market-audio-list');
    if (!list) return;
    localizeMarketAudio();
    fetch(`${import.meta.env.BASE_URL}api/market/audio`, { headers: { Accept: 'application/json' } })
    .then(response => response.ok ? response.json() : Promise.reject())
    .then(({ items, presenterSettings }) => {
      applyMarketPresenterSettings(presenterSettings);
      list.replaceChildren();
      const entries = Array.isArray(items) ? newestMarketAudioFirst(latestTestAudioRevisions(items as AudioItem[])) : [];
      if (!entries.length) { list.textContent = '目前尚無已完成的市場快報語音。'; return; }
      for (const item of entries) {
        const card = document.createElement('article');
        card.className = 'market-audio-card';
        const title = document.createElement('h3');
        title.className = 'market-audio-card-title';
        title.dataset.productType = item.productType;
        title.dataset.test = String(item.voice?.startsWith('test:') || false);
        title.dataset.mayaPending = String(item.voice === 'duo:uiobbeci:maya-pending');
        const presenter = presenterForAudio(item.createdAt, item.voice);
        title.dataset.presenterName = item.productType === 'daily'
          ? ({ maya: 'Maya', uiobbeci: 'Uiobbeci', duo: 'Maya & Uiobbeci' }[presenter])
          : '';
        const date = document.createElement('p');
        date.className = 'market-audio-date';
        date.dataset.createdAt = item.createdAt ?? '';
        date.dataset.day = item.day ?? '';
        const createdAt = marketAudioDay(item.day, language()) ?? marketAudioDateTime(item.createdAt, language());
        date.textContent = createdAt ?? '';
        date.hidden = !createdAt;
        const details = document.createElement('div');
        details.className = 'market-audio-details';
        details.append(title, date);
        const media = document.createElement('div');
        media.className = 'market-audio-media';
        const video = document.createElement('video');
        video.muted = true; video.playsInline = true; video.preload = 'metadata';
        video.setAttribute('aria-hidden', 'true');
        const frame = document.createElement('div');
        frame.className = 'presenter-frame';
        frame.dataset.full = 'false';
        frame.dataset.presenter = presenter;
        frame.append(video);
        if (presenter !== 'maya') {
          const unavailable = document.createElement('span');
          unavailable.className = 'presenter-unavailable';
          unavailable.hidden = true;
          unavailable.textContent = `${title.dataset.presenterName} video unavailable`;
          video.addEventListener('error', () => { unavailable.hidden = false; });
          video.addEventListener('playing', () => { unavailable.hidden = true; });
          video.addEventListener('loadedmetadata', () => { unavailable.hidden = true; });
          frame.append(unavailable);
        }
        const player = document.createElement('audio'); player.controls = true; player.preload = 'none';
        player.src = `${import.meta.env.BASE_URL}api/market/audio/${encodeURIComponent(item.productType)}/${encodeURIComponent(item.code)}/${item.revision}`;
        bindMarketAudioPlayback(list, player, video, presenter);
        media.append(frame, player);
        card.append(details, media); list.append(card);
      }
      localizeMarketAudio();
      void updatePresenterAccess();
    }).catch(() => { list.textContent = '市場快報暫時無法載入。'; });
  }
  document.addEventListener("astro:page-load", loadMarketAudio);
</script>

<script>
  import { GATEWAY_API_BASE } from "../common/constants/api";
  import { learningRequest, LoginRequiredError } from "../scripts/learn/learnRequest";
  import { groupLearnTopics } from "../scripts/learn/catalog";

  type Topic = {
    id: string; title: string; description: string; partCode?: string; recommendedMinutes?: number;
    questionCount: number; difficulties: number[]; state: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED";
    answeredCount: number; completedRounds: number; lastScore?: number; lastTotal?: number;
    lastSubmittedAt?: string; lastAttemptId?: number;
  };
  type SessionOption = { key: string; text: string };
  type SessionQuestion = {
    id: number; order: number; section: string; difficulty?: number; passageKey?: string;
    passageText?: string; prompt: string; options: SessionOption[]; selectedOption?: string;
  };
  type Session = {
    attemptId: number; quizId: string; quizTitle: string; description?: string; recommendedMinutes?: number;
    startedAt: string; totalQuestions: number; answeredCount: number; resumed: boolean;
    questions: SessionQuestion[];
  };
  type ReviewOption = { key: string; text: string; rationale?: string; correct: boolean; selected: boolean };
  type ReviewItem = {
    questionId: number; order: number; position?: number; section: string; difficulty?: number;
    focusPoint?: string; passageKey?: string; passageText?: string; prompt: string;
    options: ReviewOption[]; selectedOption?: string; correctOption: string; correct: boolean;
    explanation: string; lifetimeCorrect: number; lifetimeIncorrect: number;
    cohortCorrect: number; cohortIncorrect: number; cohortAccuracy?: number | null;
  };
  type RankingRow = {
    rank: number; userId: string; self: boolean; rounds: number; averageScore: number;
    averageAccuracy: number; bestScore?: number | null; averageDurationSeconds?: number | null;
    lastSubmittedAt?: string | null;
  };
  type Ranking = {
    quizId: string; quizTitle: string; questionCount: number; learnerCount: number;
    cohortAverageScore?: number | null; cohortAverageAccuracy?: number | null;
    selfRank?: number | null; rows: RankingRow[];
  };
  type Review = {
    attemptId: number; quizId: string; quizTitle: string; score: number; totalQuestions: number;
    durationSeconds?: number; submittedAt: string; items: ReviewItem[]; ranking?: Ranking | null;
  };
  type MentorTopicProgress = {
    quizId: string; quizTitle: string; state: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED";
    questionCount: number; completedRounds: number; answeredCount: number;
    averageScore?: number | null; averageAccuracy?: number | null; bestScore?: number | null;
    lastScore?: number | null; lastSubmittedAt?: string | null;
  };
  type MentorLearner = {
    userId: string; totalRounds: number; averageAccuracy?: number | null; lastActiveAt?: string | null;
    topicsInProgress: number; topicsCompleted: number; topics: MentorTopicProgress[];
  };
  type MentorOverview = {
    learnerCount: number; totalRounds: number; cohortAverageAccuracy?: number | null;
    learners: MentorLearner[];
  };
  type Profile = { userId: string; mentor: boolean };
  type ScorecardRow = {
    questionId: number; position?: number; section: string; difficulty?: number; focusPoint?: string;
    prompt: string; timesAnswered: number; correctCount: number; incorrectCount: number;
  };
  type Scorecard = {
    quizId: string; quizTitle: string; completedRounds: number; questionCount: number;
    totalCorrect: number; totalIncorrect: number; rows: ScorecardRow[];
  };

  const DIFFICULTY_LABELS: Record<number, string> = { 1: "基礎", 2: "進階", 3: "精熟", 4: "挑戰" };

  let topics: Topic[] = [];
  let currentQuizId: string | null = null;
  let session: Session | null = null;
  let answered = new Set<number>();
  let startedAt = Date.now();
  let timerId: number | undefined;
  let saving = 0;
  let profile: Profile | null = null;

  function authHeaders() {
    const token = localStorage.getItem("token");
    return { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}) };
  }

  async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
    const route = learningRequest(path, localStorage.getItem("token"));   // throws LoginRequiredError when signed out
    const response = await fetch(`${GATEWAY_API_BASE}${route.path}`, {
      ...init, headers: { ...authHeaders(), ...route.headers, ...(init.headers || {}) }
    });
    const payload = await response.json().catch(() => null);
    if (!response.ok || !payload?.success) throw new Error(payload?.message || `HTTP ${response.status}`);
    return payload.data as T;
  }

  function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function query<T extends HTMLElement>(selector: string) {
    return document.querySelector<T>(selector);
  }

  function showPhase(id: "overview" | "answering" | "review" | "scorecard" | "mentor" | "audio") {
    if (id !== "audio") document.querySelectorAll<HTMLAudioElement>('#market-audio-list audio').forEach(audio => audio.pause());
    for (const name of ["overview", "answering", "review", "scorecard", "mentor", "audio"] as const) {
      const node = query(`#learn-${name}`);
      if (node) node.hidden = name !== id;
    }
    const mayaButton = query<HTMLButtonElement>("#learn-maya-open");
    if (mayaButton) mayaButton.setAttribute("aria-current", id === "audio" ? "page" : "false");
    const status = query("#learn-status");
    if (status) status.hidden = true;
  }

  function showError(message: string) {
    const status = query("#learn-status");
    if (!status) return;
    status.textContent = message;
    status.hidden = false;
  }

  // Quizzes need a login (2026-11-03): signed out, the page says so and links to the sign-in page instead of loading topics.
  function showLoginRequired() {
    const status = query("#learn-status");
    if (!status) return;
    status.textContent = "";
    status.append("請先登入才能使用測驗。", " ", Object.assign(document.createElement("a"), { href: "/login", textContent: "前往登入" }));
    status.hidden = false;
    const topicList = query("#learn-topics");
    if (topicList) topicList.textContent = "";
  }

  // ------------------------------------------------------------- sidebar

  function difficultyBadges(topic: Topic) {
    const wrapper = element("span", "learn-badges");
    for (const level of topic.difficulties ?? []) {
      wrapper.append(element("span", `learn-badge level-${level}`, DIFFICULTY_LABELS[level] ?? `L${level}`));
    }
    return wrapper;
  }

  function renderTopics(activeId?: string) {
    const container = query("#learn-topics");
    if (!container) return;
    container.replaceChildren();

    const grouped = groupLearnTopics(topics);
    for (const topic of [...grouped.toeic, ...grouped.other]) {
      if (topic === grouped.other[0]) container.append(element("h3", "learn-other-heading", "其他練習"));
      const button = element("button", "learn-topic");
      button.type = "button";
      if (topic.id === activeId) button.classList.add("active");
      button.dataset.topicId = topic.id;

      button.append(element("span", "learn-topic-part", topic.partCode ?? "TOPIC"));
      button.append(element("span", "learn-topic-title", topic.title));
      button.append(difficultyBadges(topic));

      let status: string;
      if (topic.state === "IN_PROGRESS") {
        status = `未完成 ${topic.answeredCount} / ${topic.questionCount}，接續作答`;
        button.classList.add("in-progress");
      } else if (topic.state === "COMPLETED") {
        status = `已完成 ${topic.completedRounds} 輪｜上次 ${topic.lastScore}/${topic.lastTotal}`;
      } else {
        status = `${topic.questionCount} 題，尚未開始`;
      }
      button.append(element("span", "learn-topic-status", status));
      container.append(button);
    }

    if (!topics.length) container.append(element("p", "learn-meta", "目前沒有可作答的主題"));
  }

  // ---------------------------------------------------- answering phase

  function updateProgress() {
    if (!session) return;
    const total = session.totalQuestions;
    const done = answered.size;
    const fill = query("#learn-progress-fill");
    if (fill) fill.style.width = `${total ? (done / total) * 100 : 0}%`;
    const label = query("#learn-progress-label");
    if (label) label.textContent = `${done} / ${total}`;

    const submit = query<HTMLButtonElement>("#learn-submit");
    if (submit) {
      const complete = done >= total;
      submit.disabled = !complete || saving > 0;
      submit.textContent = complete ? "送出並進入檢討" : `還有 ${total - done} 題未作答`;
    }
  }

  function renderSession(data: Session) {
    session = data;
    currentQuizId = data.quizId;
    answered = new Set(data.questions.filter(q => q.selectedOption).map(q => q.id));

    query("#answering-title")!.textContent = data.quizTitle;
    query("#answering-description")!.textContent =
      [data.description, data.recommendedMinutes ? `建議 ${data.recommendedMinutes} 分鐘` : null]
        .filter(Boolean).join("｜");
    query("#answering-resumed")!.textContent = data.resumed ? "接續上次未完成的進度" : "本輪已重新亂序";

    const container = query("#learn-questions")!;
    container.replaceChildren();
    let lastPassageKey = "";

    for (const question of data.questions) {
      if (question.passageKey && question.passageKey !== lastPassageKey && question.passageText) {
        container.append(element("article", "learn-passage", question.passageText));
        lastPassageKey = question.passageKey;
      }
      const card = element("fieldset", "learn-question");
      card.dataset.questionId = String(question.id);
      if (question.selectedOption) card.classList.add("answered");

      const head = element("div", "learn-question-head");
      head.append(element("span", "learn-question-no", String(question.order)));
      if (question.difficulty) {
        head.append(element("span", `learn-badge level-${question.difficulty}`,
          DIFFICULTY_LABELS[question.difficulty] ?? `L${question.difficulty}`));
      }
      card.append(head, element("h3", "", question.prompt));

      const choices = element("div", "learn-options");
      for (const option of question.options) {
        const label = element("label", "learn-option");
        const radio = document.createElement("input");
        radio.type = "radio";
        radio.name = `question-${question.id}`;
        radio.value = option.key;
        radio.checked = question.selectedOption === option.key;
        label.append(radio, element("span", "", `(${option.key}) ${option.text}`));
        choices.append(label);
      }
      card.append(choices);
      container.append(card);
    }

    startedAt = Date.now();
    startTimer();
    updateProgress();
    showPhase("answering");
  }

  async function persistAnswer(questionId: number, selectedOption: string) {
    if (!session) return;
    saving++;
    const notice = query("#learn-notice");
    if (notice) notice.textContent = "儲存中…";
    try {
      const ack = await request<{ answeredCount: number }>(
        `/learn/topics/${session.quizId}/session/answers`,
        { method: "POST", body: JSON.stringify({ questionId, selectedOption }) }
      );
      answered.add(questionId);
      if (notice) notice.textContent = `已儲存 ${ack.answeredCount} 題`;
    } catch (error) {
      if (notice) notice.textContent = error instanceof Error ? error.message : "儲存失敗，請再試一次";
    } finally {
      saving--;
      updateProgress();
    }
  }

  function startTimer() {
    if (timerId) window.clearInterval(timerId);
    const tick = () => {
      const seconds = Math.floor((Date.now() - startedAt) / 1000);
      const minutes = Math.floor(seconds / 60).toString().padStart(2, "0");
      const node = query("#learn-timer");
      if (node) node.textContent = `${minutes}:${(seconds % 60).toString().padStart(2, "0")}`;
    };
    tick();
    timerId = window.setInterval(tick, 1000);
  }

  function stopTimer() {
    if (timerId) window.clearInterval(timerId);
    timerId = undefined;
  }

  // ----------------------------------------------------------- ranking

  function percent(value?: number | null) {
    return value === null || value === undefined ? "—" : `${Math.round(value * 100)}%`;
  }

  /** 排行榜只放平均值，不會出現別人的答案；作答階段不會呼叫，只在檢討模式顯示。 */
  function renderRanking(ranking?: Ranking | null) {
    const container = query("#learn-ranking");
    if (!container) return;
    container.replaceChildren();
    if (!ranking || !ranking.rows.length) {
      container.hidden = true;
      return;
    }
    container.hidden = false;

    const head = element("div", "learn-ranking-head");
    head.append(element("h2", "", "排行榜"));
    head.append(element("p", "learn-meta",
      `${ranking.learnerCount} 位學習者｜全體平均 ${
        ranking.cohortAverageScore === null || ranking.cohortAverageScore === undefined
          ? "—" : ranking.cohortAverageScore.toFixed(1)
      } / ${ranking.questionCount}（正確率 ${percent(ranking.cohortAverageAccuracy)}）${
        ranking.selfRank ? `｜你目前第 ${ranking.selfRank} 名` : ""
      }`));
    container.append(head);

    const table = element("table", "learn-scorecard-table");
    const header = element("tr");
    for (const label of ["名次", "帳號", "完成輪數", "平均分數", "正確率", "最佳", "平均用時", "最後作答"]) {
      header.append(element("th", "", label));
    }
    table.append(header);

    for (const row of ranking.rows) {
      const tr = element("tr");
      if (row.self) tr.classList.add("is-self");
      tr.append(element("td", "", String(row.rank)));
      tr.append(element("td", "", row.self ? `${row.userId}（你）` : row.userId));
      tr.append(element("td", "", String(row.rounds)));
      tr.append(element("td", "", row.averageScore.toFixed(1)));
      tr.append(element("td", "", percent(row.averageAccuracy)));
      tr.append(element("td", "", row.bestScore === null || row.bestScore === undefined ? "—" : String(row.bestScore)));
      tr.append(element("td", "", row.averageDurationSeconds
        ? `${Math.round(row.averageDurationSeconds / 60)} 分` : "—"));
      tr.append(element("td", "", row.lastSubmittedAt
        ? new Date(row.lastSubmittedAt).toLocaleDateString() : "—"));
      table.append(tr);
    }
    container.append(table);
  }

  // ------------------------------------------------------- review phase

  function renderReview(review: Review) {
    stopTimer();
    currentQuizId = review.quizId;
    query("#review-title")!.textContent = review.quizTitle;
    const minutes = review.durationSeconds ? `｜用時 ${Math.round(review.durationSeconds / 60)} 分鐘` : "";
    query("#review-summary")!.textContent =
      `得分 ${review.score} / ${review.totalQuestions}${minutes}｜逐題檢討，每個選項都說明為何對或為何錯`;
    renderRanking(review.ranking);

    const body = query("#learn-review-body")!;
    body.replaceChildren();
    let lastPassageKey = "";

    for (const item of review.items) {
      if (item.passageKey && item.passageKey !== lastPassageKey && item.passageText) {
        body.append(element("article", "learn-passage", item.passageText));
        lastPassageKey = item.passageKey;
      }
      const card = element("article", `learn-question ${item.correct ? "correct" : "incorrect"}`);

      const head = element("div", "learn-question-head");
      head.append(element("span", "learn-question-no", String(item.order)));
      head.append(element("span", `learn-verdict ${item.correct ? "ok" : "ng"}`, item.correct ? "答對" : "答錯"));
      if (item.difficulty) {
        head.append(element("span", `learn-badge level-${item.difficulty}`,
          DIFFICULTY_LABELS[item.difficulty] ?? `L${item.difficulty}`));
      }
      if (item.focusPoint) head.append(element("span", "learn-focus", item.focusPoint));
      card.append(head, element("h3", "", item.prompt));

      const list = element("div", "learn-options review");
      for (const option of item.options) {
        const row = element("div", "learn-review-option");
        if (option.correct) row.classList.add("is-correct");
        if (option.selected) row.classList.add("is-selected");

        const marks = [option.correct ? "正解" : null, option.selected ? "你的選擇" : null].filter(Boolean);
        const heading = element("p", "learn-review-option-head",
          `(${option.key}) ${option.text}${marks.length ? `　— ${marks.join("／")}` : ""}`);
        row.append(heading);
        if (option.rationale) row.append(element("p", "learn-rationale", option.rationale));
        list.append(row);
      }
      card.append(list);

      if (item.explanation) {
        const box = element("div", "learn-explanation");
        box.append(element("strong", "", "整題重點"), element("p", "", item.explanation));
        card.append(box);
      }
      card.append(element("p", "learn-performance",
        `這一題你累計答對 ${item.lifetimeCorrect} 次／答錯 ${item.lifetimeIncorrect} 次`));
      const crowdTotal = item.cohortCorrect + item.cohortIncorrect;
      card.append(element("p", "learn-performance cohort", crowdTotal
        ? `所有人平均：作答 ${crowdTotal} 次，正確率 ${percent(item.cohortAccuracy)}`
        : "所有人平均：目前還沒有其他作答紀錄"));
      body.append(card);
    }

    showPhase("review");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function renderScorecard(card: Scorecard) {
    query("#scorecard-title")!.textContent = card.quizTitle;
    query("#scorecard-summary")!.textContent =
      `已完成 ${card.completedRounds} 輪｜累計答對 ${card.totalCorrect} 次、答錯 ${card.totalIncorrect} 次｜依答錯次數由高至低排列`;

    const body = query("#learn-scorecard-body")!;
    body.replaceChildren();

    const table = element("table", "learn-scorecard-table");
    const head = element("tr");
    for (const label of ["題號", "考點", "難度", "作答次數", "答對", "答錯"]) {
      head.append(element("th", "", label));
    }
    table.append(head);

    for (const row of card.rows) {
      const tr = element("tr");
      if (row.incorrectCount > 0) tr.classList.add("has-errors");
      tr.append(element("td", "", row.position ? String(row.position) : "—"));
      tr.append(element("td", "learn-scorecard-focus", row.focusPoint || row.prompt.slice(0, 40) + "…"));
      tr.append(element("td", "", row.difficulty ? (DIFFICULTY_LABELS[row.difficulty] ?? `L${row.difficulty}`) : "—"));
      tr.append(element("td", "", String(row.timesAnswered)));
      tr.append(element("td", "", String(row.correctCount)));
      tr.append(element("td", "learn-scorecard-wrong", String(row.incorrectCount)));
      table.append(tr);
    }
    body.append(table);
    showPhase("scorecard");
  }

  // -------------------------------------------------------- mentor mode

  const STATE_LABELS: Record<MentorTopicProgress["state"], string> = {
    NOT_STARTED: "尚未開始", IN_PROGRESS: "作答中", COMPLETED: "已完成"
  };

  function renderMentor(overview: MentorOverview) {
    query("#mentor-summary")!.textContent =
      `${overview.learnerCount} 個帳號｜累計 ${overview.totalRounds} 輪｜全體平均正確率 ${percent(overview.cohortAverageAccuracy)}`;

    const body = query("#learn-mentor-body")!;
    body.replaceChildren();

    if (!overview.learners.length) {
      body.append(element("p", "learn-meta", "目前還沒有任何帳號作答"));
      showPhase("mentor");
      return;
    }

    for (const learner of overview.learners) {
      const card = element("article", "learn-question");
      const head = element("div", "learn-question-head");
      head.append(element("span", "learn-topic-title", learner.userId));
      head.append(element("span", "learn-badge", `${learner.totalRounds} 輪`));
      head.append(element("span", "learn-badge", `正確率 ${percent(learner.averageAccuracy)}`));
      if (learner.topicsInProgress) {
        head.append(element("span", "learn-badge level-3", `${learner.topicsInProgress} 個主題作答中`));
      }
      head.append(element("span", "learn-focus", learner.lastActiveAt
        ? `最後作答 ${new Date(learner.lastActiveAt).toLocaleString()}` : "尚未送出任何一輪"));
      card.append(head);

      const table = element("table", "learn-scorecard-table");
      const header = element("tr");
      for (const label of ["主題", "狀態", "完成輪數", "平均分數", "正確率", "最佳", "上一輪", "最後作答"]) {
        header.append(element("th", "", label));
      }
      table.append(header);

      for (const topic of learner.topics) {
        const tr = element("tr");
        if (topic.state === "IN_PROGRESS") tr.classList.add("has-errors");
        tr.append(element("td", "learn-scorecard-focus", topic.quizTitle));
        tr.append(element("td", "", topic.state === "IN_PROGRESS"
          ? `${STATE_LABELS[topic.state]}（${topic.answeredCount}/${topic.questionCount}）`
          : STATE_LABELS[topic.state]));
        tr.append(element("td", "", String(topic.completedRounds)));
        tr.append(element("td", "", topic.averageScore === null || topic.averageScore === undefined
          ? "—" : topic.averageScore.toFixed(1)));
        tr.append(element("td", "", percent(topic.averageAccuracy)));
        const best = topic.bestScore;
        const last = topic.lastScore;
        tr.append(element("td", "", best === null || best === undefined ? "—" : String(best)));
        tr.append(element("td", "", last === null || last === undefined
          ? "—" : `${last} / ${topic.questionCount}`));
        tr.append(element("td", "", topic.lastSubmittedAt
          ? new Date(topic.lastSubmittedAt).toLocaleDateString() : "—"));
        table.append(tr);
      }
      card.append(table);
      body.append(card);
    }
    showPhase("mentor");
  }

  async function loadMentor() {
    try {
      renderMentor(await request<MentorOverview>("/learn/mentor/overview"));
    } catch (error) {
      showError(error instanceof Error ? error.message : "無法讀取全班作答狀況");
    }
  }

  // ------------------------------------------------------------- actions

  async function openTopic(quizId: string) {
    renderTopics(quizId);
    try {
      const topic = topics.find(item => item.id === quizId);
      // 已完成且沒有進行中的一輪：先看上一輪檢討，由使用者決定是否再寫一輪
      if (topic?.state === "COMPLETED" && topic.lastAttemptId) {
        renderReview(await request<Review>(`/learn/attempts/${topic.lastAttemptId}/review`));
        return;
      }
      renderSession(await request<Session>(`/learn/topics/${quizId}/session`, { method: "POST" }));
    } catch (error) {
      showError(error instanceof Error ? error.message : "無法開啟這個主題");
    }
  }

  async function startNewRound(quizId: string) {
    try {
      renderSession(await request<Session>(`/learn/topics/${quizId}/session`, { method: "POST" }));
      await loadTopics(quizId);
    } catch (error) {
      showError(error instanceof Error ? error.message : "無法開始新的一輪");
    }
  }

  async function submitAttempt(event: SubmitEvent) {
    event.preventDefault();
    if (!session) return;
    const button = query<HTMLButtonElement>("#learn-submit")!;
    button.disabled = true;
    try {
      const review = await request<Review>(`/learn/topics/${session.quizId}/attempts`, {
        method: "POST",
        body: JSON.stringify({ durationSeconds: Math.floor((Date.now() - startedAt) / 1000) })
      });
      renderReview(review);
      await loadTopics(session.quizId);
      await loadHistory();
    } catch (error) {
      button.disabled = false;
      const notice = query("#learn-notice");
      if (notice) notice.textContent = error instanceof Error ? error.message : "送出失敗";
    }
  }

  async function loadTopics(activeId?: string) {
    topics = await request<Topic[]>("/learn/topics");
    renderTopics(activeId);
  }

  async function loadHistory() {
    const target = query("#learn-history-content");
    if (!target) return;
    try {
      const history = await request<Array<{ displayName: string; submittedAt: string; score: number; totalQuestions: number; quizTitle: string }>>("/learn/attempts/recent");
      if (!history.length) {
        target.textContent = "尚無紀錄";
        return;
      }
      target.replaceChildren(...history.slice(0, 6).map(item => element("p", "learn-history-row",
        `${new Date(item.submittedAt).toLocaleDateString()}　${item.quizTitle}　${item.score}/${item.totalQuestions}`)));
    } catch {
      target.textContent = "暫時無法讀取作答紀錄";
    }
  }

  function bindOnce(node: HTMLElement | null, key: string, type: string, handler: EventListener) {
    if (!node || node.dataset[key] === "true") return;
    node.dataset[key] = "true";
    node.addEventListener(type, handler);
  }

  async function initLearn() {
    const shell = document.querySelector(".learn-shell");
    if (!shell) {
      stopTimer();
      return;
    }
    bindOnce(query("#learn-topics"), "bound", "click", event => {
      const button = (event.target as HTMLElement).closest<HTMLElement>("[data-topic-id]");
      if (button?.dataset.topicId) void openTopic(button.dataset.topicId);
    });
    bindOnce(query("#learn-home"), "bound", "click", () => {
      stopTimer(); showPhase("overview"); renderTopics();
      document.querySelectorAll<HTMLElement>("[data-catalog-subject], [data-catalog-course]").forEach(node => { node.hidden = false; });
      document.querySelectorAll<HTMLElement>("[data-submenu]").forEach(node => { node.hidden = true; });
      document.querySelectorAll<HTMLElement>(".learn-subject-button").forEach(node => node.removeAttribute("aria-current"));
    });
    bindOnce(query(".learn-subject-menu"), "bound", "click", event => {
      const button = (event.target as HTMLElement).closest<HTMLElement>("[data-subject-id]");
      if (!button?.dataset.subjectId) return;
      stopTimer(); showPhase("overview");
      document.querySelectorAll<HTMLElement>("[data-submenu]").forEach(node => { node.hidden = node.dataset.submenu !== button.dataset.subjectId; });
      document.querySelectorAll<HTMLElement>(".learn-subject-button").forEach(node => { node.setAttribute("aria-current", node.dataset.subjectId === button.dataset.subjectId ? "page" : "false"); });
      document.querySelectorAll<HTMLElement>("[data-catalog-subject]").forEach(node => { node.hidden = node.dataset.catalogSubject !== button.dataset.subjectId; });
      document.querySelectorAll<HTMLElement>("[data-catalog-course]").forEach(node => { node.hidden = !!button.dataset.courseId && node.dataset.catalogCourse !== button.dataset.courseId; });
    });
    bindOnce(query("#learn-maya-open"), "bound", "click", () => { stopTimer(); showPhase("audio"); });
    bindOnce(query("#learn-overview"), "toeicBound", "click", event => {
      const target = (event.target as HTMLElement).closest("[data-learn-toeic]");
      if (!target) return;
      event.preventDefault();
      if (!localStorage.getItem("token")) { showLoginRequired(); return; }
      const toeic = groupLearnTopics(topics).toeic;
      if (toeic.length) void openTopic(toeic[0].id);
      else showError("題庫尚未載入，請稍後再試。");
    });

    bindOnce(query("#learn-form"), "bound", "submit", event => void submitAttempt(event as SubmitEvent));

    bindOnce(query("#learn-questions"), "bound", "change", event => {
      const input = event.target as HTMLInputElement;
      if (input?.type !== "radio") return;
      const card = input.closest<HTMLElement>("[data-question-id]");
      if (!card?.dataset.questionId) return;
      card.classList.add("answered");
      void persistAnswer(Number(card.dataset.questionId), input.value);
    });

    bindOnce(query("#review-restart"), "bound", "click", () => {
      if (currentQuizId) void startNewRound(currentQuizId);
    });

    bindOnce(query("#review-scorecard"), "bound", "click", () => {
      if (!currentQuizId) return;
      void request<Scorecard>(`/learn/topics/${currentQuizId}/scorecard`).then(renderScorecard)
        .catch(error => showError(error instanceof Error ? error.message : "無法讀取成績單"));
    });

    bindOnce(query("#scorecard-back"), "bound", "click", () => showPhase("review"));

    bindOnce(query("#learn-mentor-open"), "bound", "click", () => void loadMentor());
    bindOnce(query("#mentor-refresh"), "bound", "click", () => void loadMentor());

    if (!localStorage.getItem("token")) {
      showPhase("overview");
      showLoginRequired();
      return;
    }
    try {
      showPhase("overview");
      await loadTopics();
      await loadHistory();
      // 導師帳號一進來就直接看到全班作答狀況，不必先挑主題。
      profile = localStorage.getItem("token") ? await request<Profile>("/learn/profile").catch(() => null) : null;
      const mentorButton = query("#learn-mentor-open");
      if (mentorButton) mentorButton.hidden = !profile?.mentor;
      if (profile?.mentor) await loadMentor();
    } catch (error) {
      if (error instanceof LoginRequiredError) return showLoginRequired();
      const topicList = query("#learn-topics");
      if (topicList && !topics.length) topicList.textContent = "題庫暫時無法載入，請稍後重新整理。";
      showError(error instanceof Error ? error.message : "主題載入失敗");
    }
  }

  document.addEventListener("astro:page-load", initLearn);
</script>
