  function addPaddingToImage(url: string): Promise<Blob | null> {
    return new Promise((resolve) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        // 左右各 18%、上方 20%、下方 25%（與 server 端 sharp 邊框一致）
        const padLeft = Math.round(img.width * 0.18);
        const padRight = Math.round(img.width * 0.18);
        const padTop = Math.round(img.height * 0.2);
        const padBottom = Math.round(img.height * 0.25);
        const canvas = document.createElement('canvas');
        canvas.width = img.width + padLeft + padRight;
        canvas.height = img.height + padTop + padBottom;
        const ctx = canvas.getContext('2d');
        if (!ctx) { resolve(null); return; }
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, padLeft, padTop);
        canvas.toBlob(blob => resolve(blob), 'image/png');
      };
      img.onerror = () => resolve(null);
      img.src = url;
    });
  }

  async function saveImagesToBrowserDirectory(padded: boolean) {
    const picker = (window as any).showDirectoryPicker;
    if (!window.isSecureContext || typeof picker !== 'function') return null;

    let directory: any;
    try {
      directory = await picker.call(window, {
        id: padded ? 'palais-characters-padded' : 'palais-characters',
        mode: 'readwrite',
      });
    } catch (error) {
      if ((error as DOMException)?.name === 'AbortError') {
        return { cancelled: true, padded, requested: 0, saved: 0, failures: [] };
      }
      throw error;
    }

    let saved = 0;
    const failures: Array<{ name: string; error: string }> = [];
    const timestamp = characterService.getMediaTimestamp();

    for (const character of currentFilteredData) {
      const name = character.name || 'default';
      const imageUrl = `${PEOPLE_IMAGE_URL}/${encodeURIComponent(name)}.png?t=${timestamp}`;
      try {
        const blob = padded
          ? await addPaddingToImage(imageUrl)
          : await fetch(imageUrl).then((response) => {
              if (!response.ok) throw new Error(`Image download failed (${response.status})`);
              return response.blob();
            });
        if (!blob) throw new Error('Image processing failed');

        const fileHandle = await directory.getFileHandle(`${name}.png`, { create: true });
        const writable = await fileHandle.createWritable();
        await writable.write(blob);
        await writable.close();
        saved += 1;
      } catch (error) {
        failures.push({
          name,
          error: error instanceof Error ? error.message : String(error),
        });
      }
    }

    return {
      source: 'browser-directory',
      padded,
      requested: currentFilteredData.length,
      saved,
      failures,
    };
  }

  async function saveImagesDirectlyOnLocalWindows(padded: boolean) {
    const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname);
    if (!isLocalhost) {
      const browserResult = await saveImagesToBrowserDirectory(padded);
      if (browserResult) return browserResult;
    }

    const endpoint = '/tymultiverse/api/local-character-download';
    let capabilityResponse: Response;
    try {
      capabilityResponse = await fetch(endpoint, {
        headers: { Accept: 'application/json' },
      });
    } catch {
      return null;
    }

    if (!capabilityResponse.ok) return null;
    const capability = await capabilityResponse.json();
    if (!capability.available) return null;

    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify({
        names: currentFilteredData.map((character) => character.name || 'default'),
        padded,
      }),
    });
    const result = await response.json();
    if (!response.ok) {
      throw new Error(result.error || 'Local image save failed');
    }
    return result;
  }

  async function saveImagesDirectlyOnLocalMac(
    padded: boolean,
    onProgress: (completed: number, total: number) => void,
  ) {
    const endpoint = '/tymultiverse/api/save-character-image';
    let capabilityResponse: Response;
    try {
      capabilityResponse = await fetch(endpoint, {
        headers: { Accept: 'application/json' },
      });
    } catch {
      return null;
    }

    if (!capabilityResponse.ok) return null;
    const capability = await capabilityResponse.json();
    if (!capability.available) return null;

    let saved = 0;
    const failures: Array<{ name: string; error: string }> = [];
    const total = currentFilteredData.length;

    for (const character of currentFilteredData) {
      const name = character.name || 'default';
      const imageUrl = `${PEOPLE_IMAGE_URL}/${encodeURIComponent(name)}.png?t=${characterService.getMediaTimestamp()}`;
      try {
        const blob = padded
          ? await addPaddingToImage(imageUrl)
          : await fetch(imageUrl).then((response) => {
              if (!response.ok) throw new Error(`圖片下載失敗 (${response.status})`);
              return response.blob();
            });
        if (!blob) throw new Error('圖片處理失敗');

        const form = new FormData();
        form.append('file', blob, `${name}.png`);
        form.append('fileName', `${name}.png`);
        form.append('padded', String(padded));
        const response = await fetch(endpoint, { method: 'POST', body: form });
        if (!response.ok) throw new Error(await response.text() || `寫入失敗 (${response.status})`);
        saved++;
      } catch (error) {
        failures.push({
          name,
          error: error instanceof Error ? error.message : String(error),
        });
      }
      onProgress(saved + failures.length, total);
    }

    return { ...capability, padded, requested: total, saved, failures };
  }

  function formatSaveResult(result: {
    requested: number;
    saved: number;
    failures?: Array<{ name: string; error: string }>;
  }) {
    const failed = result.failures?.length || 0;
    return failed > 0
      ? `已覆蓋 ${result.saved}/${result.requested} 張，失敗 ${failed} 張`
      : `已覆蓋 ${result.saved}/${result.requested} 張`;
  }

  function alertSaveFailures(
    title: string,
    failures?: Array<{ name: string; error: string }>,
  ) {
    if (!failures?.length) return;
    const preview = failures
      .slice(0, 8)
      .map((failure) => `${failure.name}: ${failure.error}`)
      .join('\n');
    const suffix = failures.length > 8 ? `\n...還有 ${failures.length - 8} 筆` : '';
    alert(`${title}\n${preview}${suffix}`);
  }

  // 用 astro:page-load 而非 DOMContentLoaded：BaseLayout 有 ClientRouter（View Transitions），
  // SPA 導航切進本頁時 DOMContentLoaded 不會再觸發，會導致 loadData 沒跑、圖片不顯示。
  // astro:page-load 在初次載入與每次 SPA 導航都會觸發（頁內元素皆有 null 檢查，離開本頁也安全）。
  document.addEventListener("astro:page-load", async function () {
    const groupContainer = document.getElementById('group-container');
    if (!groupContainer || groupContainer.dataset.initialized === 'true') return;
    groupContainer.dataset.initialized = 'true';

    initCart();
    loadData();

    const refreshBtn = document.getElementById('refresh-data');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => loadData(true));
    }

    const refreshImagesBtn = document.getElementById('refresh-images');
    if (refreshImagesBtn) {
      refreshImagesBtn.addEventListener('click', refreshImages);
    }

    const resetOrderBtn = document.getElementById('reset-group-order');
    if (resetOrderBtn) {
      resetOrderBtn.addEventListener('click', resetAllGroupOrders);
    }

    const buildIndexBtn = document.getElementById('build-pair-index');
    if (buildIndexBtn) {
      buildIndexBtn.addEventListener('click', rebuildPairVideoIndex);
    }

    const downloadBtn = document.getElementById('download-all-png');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', async () => {
        try {
          downloadBtn.setAttribute('disabled', 'true');
          const originalText = downloadBtn.innerHTML;
          downloadBtn.textContent = '準備中...';

          const localResult = await saveImagesDirectlyOnLocalWindows(false);
          if (localResult) {
            if (localResult.cancelled) {
              downloadBtn.removeAttribute('disabled');
              downloadBtn.innerHTML = originalText;
              return;
            }
            downloadBtn.textContent = formatSaveResult(localResult);
            alertSaveFailures('部分圖片沒有覆蓋到：', localResult.failures);
            setTimeout(() => {
              downloadBtn.removeAttribute('disabled');
              downloadBtn.innerHTML = originalText;
            }, 3000);
            return;
          }

          const macResult = await saveImagesDirectlyOnLocalMac(false, (completed, total) => {
            downloadBtn.textContent = `寫入中 (${completed}/${total})...`;
          });
          if (macResult) {
            downloadBtn.textContent = formatSaveResult(macResult);
            alertSaveFailures('部分圖片沒有覆蓋到：', macResult.failures);
            setTimeout(() => {
              downloadBtn.removeAttribute('disabled');
              downloadBtn.innerHTML = originalText;
            }, 3000);
            return;
          }

          if (typeof (window as any).JSZip === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
            await new Promise((resolve, reject) => {
              script.onload = resolve;
              script.onerror = reject;
              document.head.appendChild(script);
            });
          }

          const JSZip = (window as any).JSZip;
          const zip = new JSZip();
          const imgFolder = zip.folder("characters");

          let completed = 0;
          const total = currentFilteredData.length;
          downloadBtn.textContent = `下載中 (0/${total})...`;

          await Promise.all(currentFilteredData.map(async (char) => {
            const imgName = char.name || 'default';
            const imgUrl = `${PEOPLE_IMAGE_URL}/${encodeURIComponent(imgName)}.png?t=${characterService.getMediaTimestamp()}`;
            try {
              const response = await fetch(imgUrl);
              if (response.ok) {
                const blob = await response.blob();
                imgFolder.file(`${imgName}.png`, blob);
              }
              completed++;
              downloadBtn.textContent = `下載中 (${completed}/${total})...`;
            } catch (err) {
              console.warn(`無法下載圖片: ${imgUrl}`, err);
              completed++;
            }
          }));

          downloadBtn.textContent = '壓縮中...';
          const content = await zip.generateAsync({ type: "blob" });

          const link = document.createElement('a');
          link.href = URL.createObjectURL(content);
          link.download = `palais_characters_${new Date().toISOString().split('T')[0]}.zip`;
          link.click();

          downloadBtn.textContent = '已下載 zip（未直接覆蓋）';
          setTimeout(() => {
            downloadBtn.removeAttribute('disabled');
            downloadBtn.innerHTML = originalText;
          }, 3000);
        } catch (error) {
          console.error('下載失敗:', error);
          alert('下載失敗: ' + (error as any).message);
          downloadBtn.removeAttribute('disabled');
          downloadBtn.textContent = '下載失敗，請重試';
        }
      });
    }

    const downloadPaddedBtn = document.getElementById('download-all-padded');
    if (downloadPaddedBtn) {
      downloadPaddedBtn.addEventListener('click', async () => {
        try {
          downloadPaddedBtn.setAttribute('disabled', 'true');
          const originalText = downloadPaddedBtn.innerHTML;
          downloadPaddedBtn.textContent = '準備中...';

          const localResult = await saveImagesDirectlyOnLocalWindows(true);
          if (localResult) {
            if (localResult.cancelled) {
              downloadPaddedBtn.removeAttribute('disabled');
              downloadPaddedBtn.innerHTML = originalText;
              return;
            }
            downloadPaddedBtn.textContent = formatSaveResult(localResult);
            alertSaveFailures('部分含邊框圖片沒有覆蓋到：', localResult.failures);
            setTimeout(() => {
              downloadPaddedBtn.removeAttribute('disabled');
              downloadPaddedBtn.innerHTML = originalText;
            }, 3000);
            return;
          }

          const macResult = await saveImagesDirectlyOnLocalMac(true, (completed, total) => {
            downloadPaddedBtn.textContent = `處理中 (${completed}/${total})...`;
          });
          if (macResult) {
            downloadPaddedBtn.textContent = formatSaveResult(macResult);
            alertSaveFailures('部分含邊框圖片沒有覆蓋到：', macResult.failures);
            setTimeout(() => {
              downloadPaddedBtn.removeAttribute('disabled');
              downloadPaddedBtn.innerHTML = originalText;
            }, 3000);
            return;
          }

          if (typeof (window as any).JSZip === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
            await new Promise((resolve, reject) => {
              script.onload = resolve;
              script.onerror = reject;
              document.head.appendChild(script);
            });
          }

          const JSZip = (window as any).JSZip;
          const zip = new JSZip();
          const imgFolder = zip.folder("characters_padded");

          let completed = 0;
          const total = currentFilteredData.length;
          downloadPaddedBtn.textContent = `處理中 (0/${total})...`;

          await Promise.all(currentFilteredData.map(async (char) => {
            const imgName = char.name || 'default';
            const imgUrl = `${PEOPLE_IMAGE_URL}/${encodeURIComponent(imgName)}.png?t=${characterService.getMediaTimestamp()}`;
            try {
              const blob = await addPaddingToImage(imgUrl);
              if (blob) imgFolder.file(`${imgName}.png`, blob);
            } catch (err) {
              console.warn(`無法處理圖片: ${imgUrl}`, err);
            }
            completed++;
            downloadPaddedBtn.textContent = `處理中 (${completed}/${total})...`;
          }));

          downloadPaddedBtn.textContent = '壓縮中...';
          const content = await zip.generateAsync({ type: "blob" });

          const link = document.createElement('a');
          link.href = URL.createObjectURL(content);
          link.download = `palais_characters_padded_${new Date().toISOString().split('T')[0]}.zip`;
          link.click();

          downloadPaddedBtn.textContent = '已下載 zip（未直接覆蓋）';
          setTimeout(() => {
            downloadPaddedBtn.removeAttribute('disabled');
            downloadPaddedBtn.innerHTML = originalText;
          }, 3000);
        } catch (error) {
          console.error('下載失敗:', error);
          alert('下載失敗: ' + (error as any).message);
          downloadPaddedBtn.removeAttribute('disabled');
          downloadPaddedBtn.textContent = '下載失敗，請重試';
        }
      });
    }
  });
</script>
