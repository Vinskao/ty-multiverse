---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="API｜TY 市場研究室"
  description="查詢行情、總體經濟、財報與研究報告 API 規格；API 採授權制，歡迎洽詢合作。"
  canonical="https://tymultiverse.cc/api-reference/"
  lang="zh-Hant"
>
  <main class="wrapper stack gap-8 api-reference">
    <header class="stack gap-2">
      <h1 data-i18n="apiPage.title">資料 API</h1>
      <p>行情、總體經濟資料、財報與研究報告的 API 規格文件。</p>
      <p class="api-note">API 採授權制，金鑰核發、用量額度與計費方案依合作需求個別議定。如需串接資料，歡迎<a href="/#contact">與我們聯絡</a>。</p>
    </header>
    <p id="api-status" class="api-status" role="status" aria-live="polite">載入規格中…</p>
    <div id="api-groups" class="stack gap-8"></div>
  </main>
</BaseLayout>

<script>
  import { groupExamples, groupOperations, publicOperations, schemaRows } from "../scripts/api/publicSpec";

  const status = document.getElementById("api-status");
  const root = document.getElementById("api-groups");

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  async function load() {
    if (!status || !root) return;
    try {
      const response = await fetch("/maya-sawa/public-openapi.json", { headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const operations = publicOperations(await response.json(), window.location.origin);
      status.textContent = `共 ${operations.length} 個文件端點`;
      for (const [title, rows] of groupOperations(operations)) {
        const section = el("section", "api-group");
        section.append(el("h2", undefined, title));
        for (const op of rows) {
          const card = el("article", "api-op");
          const head = el("h3");
          head.append(el("span", "api-method", op.method), el("code", "api-path", op.path));
          card.append(head, el("p", "api-summary", op.summary));
          if (op.params.length) {
            const list = el("ul", "api-params");
            for (const param of op.params) {
              const item = el("li");
              // separate nodes so the English layer can translate the label and the (Chinese) description on their own
              item.append(el("span", undefined, `${param.name}（${param.where === "path" ? "路徑" : "查詢"}${param.required ? "、必填" : ""}）`));
              if (param.description) item.append(el("span", undefined, `：${param.description}`));
              list.append(item);
            }
            card.append(list);
          }
          card.append(el("pre", "api-curl", op.curl));
          for (const [venue, examples] of groupExamples(op.examples)) {
            const block = el("div", "api-examples");
            block.append(el("h4", undefined, `合法查詢範例・${venue}`));
            for (const example of examples) {
              block.append(el("p", "api-example-title", example.title), el("pre", "api-curl", example.curl));
            }
            card.append(block);
          }
          const rows = schemaRows(op.schema);
          if (rows.length) {
            const details = el("details", "api-schema");
            details.append(el("summary", undefined, `回應結構（${rows.length} 個欄位）`));
            const table = el("table", "api-schema-table");
            const head = el("tr");
            for (const label of ["欄位", "型別", "說明"]) head.append(el("th", undefined, label));
            table.append(head);
            for (const row of rows) {
              const tr = el("tr");
              tr.append(el("td", undefined, row.path), el("td", undefined, row.type), el("td", undefined, row.description));
              table.append(tr);
            }
            details.append(table);
            card.append(details);
          }
          section.append(card);
        }
        root.append(section);
      }
    } catch {
      if (status) status.textContent = "規格暫時無法載入，請稍後再試。";
    }
  }
  void load();
</script>

<style is:global>
  .api-reference code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .api-note { color: var(--gray-300); border-left: 3px solid var(--accent-regular); padding-left: 0.75rem; }
  .api-status { color: var(--gray-400); }
  .api-group h2 { margin: 0 0 0.75rem; font-size: 1.15rem; }
  .api-op { border: 1px solid var(--gray-800); border-radius: 12px; padding: 0.9rem 1rem; margin-bottom: 0.75rem; }
  .api-op h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 0 0 0.35rem; font-size: 1rem; }
  .api-method { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; padding: 0.1rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, var(--accent-regular) 18%, transparent); color: var(--accent-regular); }
  .api-path { word-break: break-all; }
  .api-summary { margin: 0 0 0.5rem; color: var(--gray-200); }
  .api-params { margin: 0 0 0.5rem; padding-left: 1.1rem; color: var(--gray-300); font-size: 0.88rem; }
  .api-examples { margin-top: 0.75rem; }
  .api-examples h4 { margin: 0 0 0.3rem; font-size: 0.85rem; color: var(--gray-200); }
  .api-example-title { margin: 0.4rem 0 0.2rem; color: var(--gray-300); font-size: 0.82rem; }
  .api-schema { margin-top: 0.75rem; }
  .api-schema summary { cursor: pointer; color: var(--gray-200); font-size: 0.88rem; }
  .api-schema-table { width: 100%; margin-top: 0.5rem; border-collapse: collapse; font-size: 0.8rem; }
  .api-schema-table th, .api-schema-table td { padding: 0.25rem 0.5rem; border-bottom: 1px solid var(--gray-800); text-align: left; vertical-align: top; }
  .api-schema-table td:first-child { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; }
  .api-curl { margin: 0; padding: 0.55rem 0.75rem; border-radius: 8px; background: color-mix(in srgb, var(--gray-800) 40%, transparent); font-size: 0.8rem; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
</style>
