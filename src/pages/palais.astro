---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import DiaryPanel from "../components/DiaryPanel.astro";
import Clutches from "../components/Clutches.html";
import { palaisModules, palaisTools } from "../scripts/palais/modules";
import i18n from "../storages/i18n.json";

const moduleText = i18n.palaisModules as Record<string, { en: string; zh: string }>;
import diaryCssUrl from "../styles/diary.css?url";
import palaisCssUrl from "../styles/palais.css?url";

// 獲取 URL 參數
const url = new URL(Astro.request.url);
const username = url.searchParams.get("username");

// 檢查登入狀態
const isLoggedIn = !!username; // #4: 不再依賴 URL token（機密改由 localStorage + 後端強制）

// 如果未登入，重定向到登入頁面
if (!isLoggedIn) {
  return Astro.redirect(
    `/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}
---

<BaseLayout title="Palais | Wavo Yuropha" description="Learn about TY's palais">
  <Fragment slot="head">
    <link rel="stylesheet" href={palaisCssUrl} />
    <link rel="stylesheet" href={diaryCssUrl} />
  </Fragment>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero title="皇宮" tagline="你的工作台：角色、社群與管理工具。" align="start" />

      <nav class="palais-toolbar" aria-label="皇宮工具列">
        {
          palaisTools().map(({ key, href }) => key === 'admin' ? (
            <a class="palais-tool-link" href={href} target="_blank" rel="noopener noreferrer">
              <span class="palais-tool-kicker">01 · ADMIN</span><strong data-i18n="palaisTools.admin">管理後台</strong><span aria-hidden="true">↗</span>
            </a>
          ) : (
              <a class="palais-tool-link" href={href} data-palais-open-tools>
              <span class="palais-tool-kicker">02 · LOCAL</span><strong data-i18n="palaisTools.clutches">檔案轉換</strong><span aria-hidden="true">↓</span>
            </a>
          ))
        }
      </nav>

      <div class="gang-video-container" data-palais-media-zoom>
        {
          [
            "https://tymultiverse.cc/images/people/gangHagisun.mp4",
            "https://tymultiverse.cc/images/people/gangHagishi.mp4",
            "https://tymultiverse.cc/images/people/gangPhoenix.mp4",
            "https://tymultiverse.cc/images/people/gangRegalos.mp4",
            "https://tymultiverse.cc/images/people/gangRapeum.mp4",
          ].map((src) => (
            <video
              src={src}
              autoplay
              muted
              loop
              playsinline
              class="gang-video"
              onerror="this.style.display='none'"
            />
          ))
        }
      </div>

      <div class="system-container module-buttons" role="navigation" aria-label="Palais modules">
        {
          palaisModules(username!).map(({ key, href }, index) => (
            <a href={href} class={`module-button module-button--${key}`} data-palais-module={key}>
              <span class="module-button-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="module-button-title" data-i18n={`palaisModules.${key}`}>{moduleText[key].en}</span>
              <span class="module-button-desc" data-i18n={`palaisModules.${key}Desc`}>{moduleText[`${key}Desc`].en}</span>
              <span class="module-button-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>

      <details id="palais-file-tools" class="palais-file-tools">
        <summary><span data-i18n="palaisTools.fileSummary">本機檔案轉換</span><span data-i18n="palaisTools.fileHint">批次轉換圖片與文字檔</span></summary>
        <Clutches />
      </details>

      <script>
        const bindPalaisToolLinks = () => {
          document.querySelectorAll<HTMLAnchorElement>("[data-palais-open-tools]").forEach((link) => {
            if (link.dataset.bound === "true") return;
            link.dataset.bound = "true";
            link.addEventListener("click", () => {
              const tools = document.querySelector<HTMLDetailsElement>("#palais-file-tools");
              if (tools) tools.open = true;
            });
          });
        };
        document.addEventListener("astro:page-load", bindPalaisToolLinks);
        bindPalaisToolLinks();
      </script>

      <DiaryPanel />
    </main>
  </div>
</BaseLayout>

<script
  async
  src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"
></script>
<script
  async
  defer
  src="https://cdnjs.cloudflare.com/ajax/libs/d3/4.2.2/d3.min.js"></script>
<script>
  import "../scripts/palaisMediaZoom";
</script>
