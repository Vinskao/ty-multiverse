---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import DiaryPanel from "../components/DiaryPanel.astro";
import { palaisModules } from "../scripts/palais/modules";
import i18n from "../storages/i18n.json";

const moduleText = i18n.palaisModules as Record<string, { en: string; zh: string }>;
import diaryCssUrl from "../styles/diary.css?url";
import palaisCssUrl from "../styles/palais.css?url";

// 獲取 URL 參數
const url = new URL(Astro.request.url);
const username = url.searchParams.get("username");

// 檢查登入狀態
const isLoggedIn = !!username; // #4: 不再依賴 URL token（機密改由 localStorage + 後端強制）

// 如果未登入，重定向到登入頁面
if (!isLoggedIn) {
  return Astro.redirect(
    `/tymultiverse/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}
---

<BaseLayout title="Palais | Wavo Yuropha" description="Learn about TY's palais">
  <Fragment slot="head">
    <link rel="stylesheet" href={palaisCssUrl} />
    <link rel="stylesheet" href={diaryCssUrl} />
  </Fragment>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero title="Palais" tagline="Welcome to Lily Palais." align="start" />

      <div class="gang-video-container" data-palais-media-zoom>
        {
          [
            "https://peoplesystem.tatdvsonorth.com/images/people/gangHagisun.mp4",
            "https://peoplesystem.tatdvsonorth.com/images/people/gangHagishi.mp4",
            "https://peoplesystem.tatdvsonorth.com/images/people/gangPhoenix.mp4",
            "https://peoplesystem.tatdvsonorth.com/images/people/gangRegalos.mp4",
            "https://peoplesystem.tatdvsonorth.com/images/people/gangRapeum.mp4",
          ].map((src) => (
            <video
              src={src}
              autoplay
              muted
              loop
              playsinline
              class="gang-video"
              onerror="this.style.display='none'"
            />
          ))
        }
      </div>

      <div class="system-container module-buttons" role="navigation" aria-label="Palais modules">
        {
          palaisModules(username!).map(({ key, href }, index) => (
            <a href={href} class={`module-button module-button--${key}`} data-palais-module={key}>
              <span class="module-button-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="module-button-title" data-i18n={`palaisModules.${key}`}>{moduleText[key].en}</span>
              <span class="module-button-desc" data-i18n={`palaisModules.${key}Desc`}>{moduleText[`${key}Desc`].en}</span>
              <span class="module-button-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>

      <DiaryPanel />
    </main>
  </div>
</BaseLayout>

<script
  async
  src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"
></script>
<script
  async
  defer
  src="https://cdnjs.cloudflare.com/ajax/libs/d3/4.2.2/d3.min.js"></script>
<script>
  import "../scripts/palaisMediaZoom";
</script>
