---
// Nav bar search: a trigger button plus the palette it opens (Ctrl/Cmd+K). Behaviour is in scripts/search/sitePalette.ts.
const pages = [
	{ href: '/reports/', zh: '報告', en: 'Reports' },
	{ href: '/macro/', zh: '總體經濟', en: 'Macro' },
	{ href: '/stocks/', zh: '個股', en: 'Stocks' },
	{ href: '/learn/', zh: '每日精讀與市場快報', en: 'Learn · Daily reading' },
	{ href: '/', zh: '首頁', en: 'Home' },
	{ href: '/work/', zh: '部落格', en: 'Blog' },
	{ href: '/api-reference/', zh: 'API 文件', en: 'API reference' },
	{ href: '/about/', zh: '關於', en: 'About' },
];
---
<button id="site-search-open" class="site-search-open" type="button" aria-haspopup="dialog" aria-controls="site-search">
	<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
	<span data-i18n="nav.search">搜尋</span>
	<kbd aria-hidden="true">Ctrl K</kbd>
</button>
<div id="site-search" class="site-search" role="dialog" aria-modal="true" aria-label="搜尋報告全文與頁面" hidden>
	<div class="site-search-panel">
		<div class="site-search-field">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
			<input id="site-search-input" type="search" autocomplete="off" placeholder="搜尋報告全文、代號或頁面…" aria-label="搜尋報告全文、代號或頁面" />
			<button type="button" class="site-search-close" data-search-close>esc</button>
		</div>
		<div class="site-search-body">
			<p id="site-search-status" class="site-search-status" role="status" aria-live="polite"></p>
			<div id="site-search-results" class="site-search-results"></div>
			<div id="site-search-pages" class="site-search-pages">
				{pages.map(({ href, zh, en }) => <a href={href} data-search-page>{zh} <span>{en}</span></a>)}
			</div>
		</div>
		<p class="site-search-hint" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> 移動 <kbd>↵</kbd> 開啟</p>
	</div>
</div>
<script>
	import { initSitePalette } from '../scripts/search/sitePalette';
	let cleanup = () => {};
	const start = () => { cleanup(); cleanup = initSitePalette(); };
	start();
	document.addEventListener('astro:page-load', start);
</script>
