---
// Apple Health statistics from the backend (ty-multiverse-backend docs/HEALTH_DATA.md); hidden until there is data.
---
<section class="health-record" data-health-record aria-labelledby="health-record-title" hidden>
  <h3 id="health-record-title">跑步與活動紀錄</h3>
  <p class="health-status" data-health-status role="status" hidden></p>
  <div data-health-body></div>
  <p class="health-credit">Powered by Apple Health and WorkOutDoors</p>
</section>

<script>
  import { initHealthRecord } from '../scripts/home/healthRecord';
  initHealthRecord();
  document.addEventListener('astro:page-load', () => initHealthRecord());
</script>

<style is:global>
  .health-record { margin: 1rem 0; max-width: 1400px; }
  .health-record h3 { font-size: var(--text-lg); margin-bottom: .6rem; }
  .health-status[aria-busy="true"]::before {
    content: ''; display: inline-block; width: 1em; height: 1em; margin-inline-end: .5rem; border-radius: 50%;
    border: 2px solid currentColor; border-right-color: transparent; animation: health-spin .8s linear infinite;
  }
  @keyframes health-spin { to { transform: rotate(360deg); } }
  .health-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .6rem; margin: 0 0 .8rem; }
  .health-tile { padding: .7rem .8rem; border: 1px solid var(--gray-700); border-radius: var(--surface-radius-small); }
  .health-month-plot {
    --axis-width: 2.75rem;
    --month-label-height: 1rem;
    position: relative; margin: 1.9rem 0 .4rem;
  }
  .health-month-plot .health-month-bars { margin: 0; padding-inline-start: var(--axis-width); }
  .health-month-bars .health-bar { position: relative; height: calc(100% - var(--month-label-height)); }
  .health-month-bars .health-bar small {
    position: absolute; inset-inline: 0; top: 100%; line-height: var(--month-label-height); text-align: center;
  }
  .health-month-bars .health-bar .health-fill { height: var(--h); min-height: 0; }
  .health-month-axis {
    position: absolute; inset: 0 0 var(--month-label-height); pointer-events: none;
    font-size: .68rem; color: var(--gray-400);
  }
  .health-month-axis::before {
    content: ''; position: absolute; inset-block: 0; inset-inline-start: var(--axis-width);
    border-inline-start: 1px solid var(--gray-700);
  }
  .health-axis-unit {
    position: absolute; bottom: calc(100% + .65rem); inset-inline-start: 0;
    width: calc(var(--axis-width) - .4rem); text-align: end;
  }
  .health-axis-tick {
    position: absolute; inset-inline: 0; transform: translateY(50%); text-align: end;
    display: grid; grid-template-columns: calc(var(--axis-width) - .4rem) 1fr; gap: .4rem; align-items: center;
  }
  .health-axis-tick::after { content: ''; border-top: 1px solid var(--gray-700); }
  .health-month .health-fill { background: none; }
  .health-month-bars .health-bar { height: calc(100% - var(--month-label-height)); }
  .health-stack { display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .health-stack-hike { display: block; flex: 1 1 auto; background: var(--gray-500, #94a3b8); opacity: .55; }
  .health-stack-run { display: block; flex: none; height: var(--run); background: var(--gray-300, #cbd5e1); }
  .health-month:is(:hover, :focus-visible) .health-stack-run { background: var(--gray-0); }
  .health-pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr)); gap: 1.6rem; align-items: start; margin: 0 0 1.6rem; }
  .health-pair .health-block { margin: 0; min-width: 0; }
  .health-block { margin: 0 0 1.6rem; }
  .health-block-title { font-size: 1.05rem; margin: 0 0 .15rem; }
  .health-caption { margin: 0 0 .6rem; font-size: .78rem; color: var(--gray-400); }
  .health-group-title { margin: .7rem 0 .35rem; font-size: .82rem; color: var(--gray-300); font-weight: 600; }
  .health-hero { margin: 0 0 .8rem; padding: .9rem 1rem; border: 1px solid var(--gray-700); border-radius: var(--surface-radius-small); }
  .health-hero p { margin: 0; }
  .health-hero-label { font-size: .8rem; color: var(--gray-400); }
  .health-hero-value { font-size: 2rem; font-weight: 700; color: var(--gray-0); line-height: 1.2; }
  .health-hero-note { font-size: .82rem; color: var(--gray-300); }
  .health-hero-up .health-hero-note { color: #6ccf8f; }
  .health-hero-down .health-hero-note { color: #f0a35e; }
  .health-legend { display: flex; flex-wrap: wrap; gap: .9rem; margin: 0 0 .3rem; font-size: .78rem; color: var(--gray-300); }
  .health-legend-item { display: inline-flex; align-items: center; gap: .35rem; }
  .health-swatch { width: .8rem; height: .8rem; border-radius: 2px; display: inline-block; }
  .health-swatch-run { background: var(--gray-300, #cbd5e1); }
  .health-swatch-hike { background: var(--gray-500, #94a3b8); opacity: .55; }
  .health-bar.is-current .health-fill { background: var(--gray-0); }
  .health-bar.is-current small { color: var(--gray-0); font-weight: 600; }
  .health-other { font-size: .95rem; margin: 1rem 0 .5rem; }
  .health-activities { display: grid; gap: .4rem; margin: 0 0 .9rem; }
  .health-activity { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: .1rem .6rem; align-items: center; font-size: .82rem; }
  .health-activity small { grid-column: 2; }
  .health-activity-track { height: .6rem; background: #8883; border-radius: 3px; overflow: hidden; }
  .health-activity-fill { display: block; width: var(--w); height: 100%; background: var(--gray-400); }
  .health-sparks { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .7rem; }
  .health-spark-card { margin: 0; padding: .7rem .8rem; border: 1px solid var(--gray-700); border-radius: var(--surface-radius-small); min-width: 0; }
  .health-spark-title { font-size: .82rem; color: var(--gray-300); }
  .health-spark { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); align-items: end; gap: 2px; height: 64px; margin: .4rem 0; }
  .health-spark-bar { height: var(--h); min-height: 2px; padding: 0; border: 0; border-radius: 2px 2px 0 0; background: var(--gray-400); cursor: pointer; }
  .health-spark-bar:is(:hover, :focus-visible) { background: var(--gray-0); }
  .hp-progress { --hp-accent: #f26b1d; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 1rem; align-items: start; margin: 0 0 1.6rem; }
  .hp-card { padding: 1rem 1.1rem; border-radius: 1rem; background: color-mix(in srgb, var(--gray-0) 6%, transparent); border: 1px solid var(--gray-700); min-width: 0; }
  .hp-chips { display: flex; gap: .5rem; overflow-x: auto; padding-bottom: .3rem; scrollbar-width: none; }
  .hp-chip { flex: none; padding: .4rem .9rem; border-radius: 999px; border: 1px solid var(--gray-500); background: none; color: var(--gray-0); font-size: .85rem; cursor: pointer; white-space: nowrap; }
  .hp-chip.is-active { border-color: var(--hp-accent); color: var(--hp-accent); }
  .hp-title { font-size: 1.15rem; font-weight: 700; margin: .9rem 0 .5rem; }
  .hp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; margin: 0; }
  .hp-stat dt { font-size: .78rem; color: var(--gray-400); }
  .hp-stat dd { margin: .1rem 0 0; font-size: 1.25rem; font-weight: 700; color: var(--gray-0); white-space: nowrap; }
  .hp-sub { margin: .9rem 0 .2rem; font-size: .78rem; color: var(--gray-400); }
  .hp-chart { width: 100%; height: auto; display: block; overflow: visible; }
  .hp-grid { stroke: var(--gray-700); stroke-width: 1; }
  .hp-axis { fill: var(--gray-400); font-size: 9px; }
  .hp-area { fill: var(--hp-accent); opacity: .22; }
  .hp-line { fill: none; stroke: var(--hp-accent); stroke-width: 2.5; stroke-linejoin: round; }
  .hp-now { stroke: var(--gray-0); stroke-width: 1.5; }
  .hp-dot { fill: var(--gray-900, #111); stroke: var(--hp-accent); stroke-width: 2; }
  .hp-dot.is-now { fill: var(--hp-accent); }
  .hp-streak-head { display: flex; justify-content: space-between; align-items: baseline; }
  .hp-streak-head .hp-title { margin-top: 0; }
  .hp-streak-head .hp-sub { margin: 0; }
  .hp-streak-body { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .hp-flame { display: grid; justify-items: center; color: var(--hp-accent); font-weight: 700; }
  .hp-flame-num { display: grid; place-items: center; width: 62px; height: 86px; background: var(--hp-accent); color: #1a1a1a; font-size: 1.6rem;
    clip-path: path('M33 0C38 16 54 22 60 38c6 16 4 30-8 40-8 7-20 9-30 6C8 80 0 68 2 54 4 42 12 36 16 26c2 10 6 14 10 16C24 26 26 12 33 0Z'); padding-top: 1.2rem; box-sizing: border-box; }
  .hp-flame-unit { font-size: 1.1rem; }
  .hp-dots { display: grid; grid-template-columns: repeat(7, .75rem); gap: .55rem; }
  .hp-day { width: .75rem; height: .75rem; border-radius: 50%; background: var(--gray-700); }
  .hp-day.is-active { background: var(--gray-0); }
  .hp-day.is-today:not(.is-active) { background: none; border: 1.5px solid var(--gray-500); box-sizing: border-box; }
  .hp-day.is-future { opacity: .45; }
  .hp-day.is-blank { visibility: hidden; }
  .health-credit { font-size: .75rem; color: var(--gray-400); }
  .health-tile dt, .health-note { font-size: .78rem; color: var(--gray-400); }
  .health-tile dd { margin: 0; }
  .health-tile .health-streak-status {
    display: inline-block; margin-top: .35rem; padding: .1rem .45rem;
    border: 1px solid var(--gray-400); border-radius: 1rem;
    color: var(--gray-0); font-size: .72rem; font-weight: 600;
  }
  .health-value { font-size: 1.2rem; font-weight: 600; color: var(--gray-0); }
  .health-chart { margin: 0 0 .8rem; }
  .health-chart figcaption, .health-readout { font-size: .82rem; color: var(--gray-300); }
  .health-bars { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3px; height: 160px; margin: .4rem 0; }
  .health-bar { display: flex; flex-direction: column; justify-content: flex-end; padding: 0; min-width: 0; border: 0; background: none; color: var(--gray-400); cursor: pointer; }
  .health-bar .health-fill { display: block; flex: none; height: calc(var(--h) * .82); min-height: 2px; background: var(--gray-400); border-radius: 3px 3px 0 0; }
  .health-bar:is(:hover, :focus-visible) .health-fill { background: var(--gray-0); }
  .health-bar small { font-size: .6rem; overflow: hidden; }
</style>
