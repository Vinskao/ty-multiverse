---
// Server-rendered chip summary of the selected holdings. It is plain HTML on purpose: AI agents that
// fetch the page without running JavaScript read this section directly. Codes only, never account values.
interface Props { brief: any | null }
const { brief } = Astro.props;

// Every signed number is its own <span>, coloured by the value *as displayed* (after rounding), so a cell
// mixing a level and a change, or a 5-day total and an opposite latest-day move, never shows one colour
// for two signs. Taiwan convention: red = up, green = down.
type Part = { text: string; cls?: string };
const round = (value: number, digits: number) => Number(value.toFixed(digits));
const toneOf = (value: number) => value > 0 ? 'market-delta--up' : value < 0 ? 'market-delta--down' : '';
const plain = (value: unknown, suffix = '', digits = 2): Part =>
	({ text: typeof value === 'number' && Number.isFinite(value) ? `${value.toLocaleString('zh-TW', { minimumFractionDigits: digits, maximumFractionDigits: digits })}${suffix}` : '—' });
const signed = (value: unknown, suffix = '', digits = 2): Part => {
	if (typeof value !== 'number' || !Number.isFinite(value)) return { text: '—' };
	const shown = round(value, digits);
	return { text: `${shown > 0 ? '+' : ''}${shown.toLocaleString('zh-TW', { minimumFractionDigits: digits, maximumFractionDigits: digits })}${suffix}`, cls: toneOf(shown) };
};
const sep: Part = { text: ' · ' };
// 5-day net, then what the latest run of days did. A run against the 5-day sign is a reversal ("轉買/轉賣").
const flowParts = (flow: any): Part[] => {
	if (!flow) return [{ text: '—' }];
	const parts = [signed(flow.net5dLots, '', 0)];
	const days = flow.streakDays || 0;
	if (!days) return parts;
	const side = days > 0 ? '買' : '賣'; const cls = toneOf(days);
	const reversal = Math.sign(days) !== Math.sign(flow.net5dLots);
	if (Math.abs(days) >= 2) parts.push(sep, { text: reversal ? `近${Math.abs(days)}日轉${side}` : `連${side}${Math.abs(days)}日`, cls });
	else if (reversal) parts.push(sep, { text: `今日轉${side} `, cls }, signed(flow.net1dLots, '', 0));
	return parts;
};
// Which selected instruments map to this stock, e.g. "持有 · QFFJ6 期貨" or "自選".
const viaText = (via: any[] | undefined) => (via ?? []).map((item) =>
	`${item.group === 'automatic' ? '持有' : '自選'}${item.productType === 'futures' ? ` · ${item.code} 期貨` : ''}`).join('、');

const names: Record<string, string> = {};
for (const item of brief?.instruments ?? []) if (item.spotCode && !names[item.spotCode]) names[item.spotCode] = item.name || '';
const stocks = Object.values(brief?.stocks ?? {}) as any[];
---
<section id="ai-brief" class="market-brief" aria-labelledby="ai-brief-title">
	<div class="market-brief-head">
		<h5 id="ai-brief-title">持股籌碼摘要 · Holdings chip summary</h5>
		<p>
			{brief ? <>產生於 <time datetime={brief.generatedAt}>{brief.generatedAt.replace('T', ' ').slice(0, 16)}</time>（台北）· </> : null}
			<a href="/tymultiverse/brief.md">Markdown</a> · <a href="/tymultiverse/brief.json">JSON</a>
		</p>
	</div>
	{!brief && <p class="market-updated">摘要暫時無法取得；請改讀 /tymultiverse/brief.md。</p>}
	{brief && stocks.length === 0 && <p class="market-updated">目前沒有可摘要的股票持股。</p>}
	{stocks.length > 0 && (
		<div class="market-fin-table-wrap">
			<table class="market-fin-table market-brief-table">
				<thead>
					<tr>
						<th scope="col">標的</th>
						<th scope="col">收盤 · 5日</th>
						<th scope="col">外資 5日(張)</th>
						<th scope="col">投信 5日(張)</th>
						<th scope="col">融資 5日</th>
						<th scope="col">大戶≥400張 週變化</th>
						<th scope="col">外資持股 20日</th>
						<th scope="col">營收年增</th>
						<th scope="col">毛利率 季變化</th>
					</tr>
				</thead>
				<tbody>
					{stocks.map((s) => {
						const foreign = s.institutional?.foreign; const trust = s.institutional?.trust;
						return (
							<tr>
								<th scope="row">{s.code} {names[s.code]}<small class="market-brief-via">{viaText(s.via)}</small></th>
								{[
									[plain(s.price?.close), sep, signed(s.price?.change5dPct, '%')],
									flowParts(foreign),
									flowParts(trust),
									[signed(s.margin?.marginBalanceChange5dPct, '%', 1)],
									[plain(s.tdcc?.largeHolderPercent, '%'), sep, signed(s.tdcc?.largeHolderChange1wPp, ' pp')],
									[plain(s.foreignHolding?.percent, '%'), sep, signed(s.foreignHolding?.change20dPp, ' pp')],
									[signed(s.fundamentals?.latestMonth?.yoyPercent, '%', 1)],
									[plain(s.fundamentals?.latestQuarter?.grossMargin, '%', 1), sep, signed(s.fundamentals?.latestQuarter?.grossMarginQoQ, ' pp')],
								].map((parts) => <td>{parts.map((part) => part.cls ? <span class={part.cls}>{part.text}</span> : part.text)}</td>)}
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	)}
	{stocks.some((s) => s.signals?.length) && (
		<ul class="market-brief-signals">
			{stocks.filter((s) => s.signals?.length).map((s) => <li><strong>{s.code} {names[s.code]}</strong>：{s.signals.join('；')}</li>)}
		</ul>
	)}
	<p class="market-fin-note">只列持有標的代號，不含張數、成本、損益或帳戶金額。張 = 1,000 股；pp = 百分點；期貨以標的現貨呈現。非投資建議。</p>
</section>
