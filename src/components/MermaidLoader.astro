<script>
  import { getMermaidConfig } from "../scripts/mermaid-theme";
  import { prepareDiagrams } from "../scripts/mermaidPlan";

  let themeObserver: MutationObserver | null = null;
  let mermaidLoading: Promise<void> | null = null;
  let renderQueue: Promise<void> = Promise.resolve();

  function renderMermaid(mermaidLib: any, force = false) {
    // Initial load and Astro page-load can arrive together. Serialize redraws
    // so a second pass never mistakes the first pass's SVG for Mermaid source.
    renderQueue = renderQueue.then(async () => {
      // Only visible diagrams that were not drawn yet (all of them when forced by a theme change); hidden ones draw on open.
      const diagrams = prepareDiagrams(Array.from(document.querySelectorAll<HTMLElement>(".mermaid")), force);
      if (!diagrams.length) return;

      await mermaidLib.run({ nodes: diagrams });
    });

    return renderQueue;
  }

  async function loadMermaid() {
    if (!window["mermaid"]) {
      mermaidLoading ??= new Promise<void>((resolve, reject) => {
        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js";
        s.onload = () => resolve();
        s.onerror = reject;
        document.head.appendChild(s);
      });
      await mermaidLoading;
    }

    const mermaidLib = window["mermaid"] as any;
    if (!mermaidLib) return;

    const isDarkMode = document.documentElement.classList.contains("theme-dark");
    const mermaidCfg = getMermaidConfig(isDarkMode);
    // Only the serialized queue may render; automatic page-load rendering
    // can race with it and try to parse SVG markup as diagram source.
    mermaidLib.initialize({ ...mermaidCfg, startOnLoad: false });

    await renderMermaid(mermaidLib);

    if (!themeObserver) {
      themeObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type !== "attributes" || mutation.attributeName !== "class") return;

          const isDark = document.documentElement.classList.contains("theme-dark");
          mermaidLib.initialize({ ...getMermaidConfig(isDark), startOnLoad: false });

          void renderMermaid(mermaidLib, true);
        });
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    }
  }

  document.addEventListener('tym:mermaid-refresh', loadMermaid);
  // diagrams inside a collapsed <details> are drawn when it is opened
  document.addEventListener('toggle', (event) => {
    if (event.target instanceof HTMLDetailsElement && event.target.open) void loadMermaid();
  }, true);
  loadMermaid();
  document.addEventListener("astro:page-load", loadMermaid);
</script>
