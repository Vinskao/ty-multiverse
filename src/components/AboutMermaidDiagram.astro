    class PG database
    class PVC,SECRET infra`,

  webfluxConsumerFlow: `flowchart TD
    Q["Classic work queue"] --> C["WebFlux consumer"]
    C --> TX["Reactive transaction"]
    TX --> WRITE["Write business data"]
    TX --> EVENT["Insert BusinessEvent into outbox"]
    WRITE --> COMMIT["Commit both writes"]
    EVENT --> COMMIT
    COMMIT --> ACK["ACK work command"]

    EVENT --> POLL["Poll unpublished rows"]
    POLL --> SEND["Publish event.* with eventId"]
    SEND --> STREAM["Append to tymb-events stream"]
    STREAM --> CONFIRM{"Publisher confirm ACK?"}
    CONFIRM -->|"yes"| DONE["Set published_at"]
    CONFIRM -->|"no / unavailable"| BACKOFF["Keep unpublished<br/>exponential backoff"]
    BACKOFF --> POLL

    DEDUPE["Downstream consumers<br/>deduplicate by eventId"]
    STREAM --> DEDUPE

    classDef mq fill:#6b21a8,stroke:#581c87,color:#ffffff
    classDef reactive fill:#166534,stroke:#14532d,color:#ffffff
    classDef data fill:#9f1239,stroke:#881337,color:#ffffff
    classDef retry fill:#92400e,stroke:#78350f,color:#ffffff
    class Q,SEND,STREAM mq
    class C,TX,POLL,CONFIRM,ACK reactive
    class WRITE,EVENT,COMMIT,DONE,DEDUPE data
    class BACKOFF retry`,

