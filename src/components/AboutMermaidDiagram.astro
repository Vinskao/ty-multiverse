  rabbitMqKubernetes: `flowchart LR
    API["Backend API<br/>Spring Boot"] -->|"AMQP commands"| CQ["Classic work queues<br/>existing async jobs"]

    subgraph OKE["OKE Kubernetes Runtime"]
      RMQ["RabbitMQ 4.1 StatefulSet<br/>AMQP 5672 · Stream 5552"]
      PVC[("OCI Block Volume PVC<br/>50 GiB · persistent")]
      SECRET["Kubernetes Secret<br/>RabbitMQ credentials"]
      CONSUMER["Consumer Pod<br/>Spring WebFlux + R2DBC"]
      PUBLISHER["Outbox Publisher<br/>confirm + retry/backoff"]
      RMQ --- PVC
      SECRET -.-> RMQ
      SECRET -.-> CONSUMER
    end

    CQ --> RMQ --> CONSUMER
    CONSUMER -->|"business write + event<br/>one transaction"| PG[("PostgreSQL<br/>business_event_outbox")]
    PG --> PUBLISHER
    PUBLISHER -->|"event.* · publisher confirm"| EX["tymb-event-exchange<br/>durable topic exchange"]
    EX -->|"event.#"| STREAM[("tymb-events stream<br/>append-only · replayable<br/>30 days / 10 GiB retention")]

    classDef producer fill:#bbdefb,stroke:#1e88e5,color:#0b1a33
    classDef mq fill:#e1bee7,stroke:#8e24aa,color:#0b1a33
    classDef consumer fill:#c8e6c9,stroke:#2e7d32,color:#0b1a33
