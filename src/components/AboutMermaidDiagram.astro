  springSecurityFilterFlow: `flowchart TD
    REQ["HTTP Request<br/>Authorization: Bearer JWT"] --> CORS["CorsFilter"]
    CORS --> SC["SecurityContextHolderFilter<br/>create / load context"]
    SC --> JWT["BearerTokenAuthenticationFilter<br/>extract Bearer token"]
    JWT --> DEC["JwtDecoder<br/>signature, issuer, expiry"]
    DEC --> AUTH["JwtAuthenticationConverter<br/>claims to GrantedAuthority"]
    AUTH --> AUTHZ["AuthorizationFilter<br/>request matcher + authenticated"]
    AUTHZ --> MVC["DispatcherServlet and MVC pipeline"]
    MVC --> METHOD["@PreAuthorize / @Secured<br/>method security"]
    METHOD --> CTRL["@RestController"]
    CTRL --> OK["200 JSON response"]

    DEC -. "invalid / expired" .-> ENTRY["AuthenticationEntryPoint<br/>401 Unauthorized"]
    AUTHZ -. "insufficient role" .-> DENIED["AccessDeniedHandler<br/>403 Forbidden"]
    METHOD -. "access denied" .-> DENIED

