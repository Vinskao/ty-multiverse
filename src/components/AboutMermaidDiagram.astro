  springMvcRequestFlow: `flowchart TD
    CLIENT["Browser / API Client"] --> TOMCAT["Embedded Tomcat<br/>Servlet Container"]

    subgraph SERVLET["Servlet request pipeline"]
      TOMCAT --> FILTER["Servlet Filter Chain<br/>CORS / request logging / Spring Security"]
      FILTER --> DS["DispatcherServlet<br/>Spring MVC front controller"]
      DS --> HM["HandlerMapping<br/>find Controller method"]
      HM --> PRE["HandlerInterceptor.preHandle<br/>trace / tenant / audit checks"]
      PRE --> BIND["HandlerMethodArgumentResolver<br/>JSON body + @Valid binding"]
      BIND --> CTRL["@RestController<br/>request orchestration"]
      CTRL --> SVC["@Service<br/>transactional business logic"]
      SVC --> REPO["@Repository<br/>JPA / JDBC data access"]
      REPO --> DB[("PostgreSQL")]
    end

    DB --> REPO
    REPO --> SVC
    SVC --> CTRL
    CTRL --> POST["HandlerInterceptor.postHandle<br/>response metadata"]
    POST --> CONV["HttpMessageConverter<br/>object to JSON"]
    CONV --> FILTEROUT["Filter Chain returns response"]
    FILTEROUT --> CLIENT

    CTRL -. "throws exception" .-> ADVICE["@RestControllerAdvice<br/>central error response"]
    SVC -. "throws exception" .-> ADVICE
    ADVICE --> CONV

