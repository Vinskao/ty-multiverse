  springExceptionResolutionFlow: `flowchart TD
    REQ["HTTP Request"] --> MVC["DispatcherServlet"]
    MVC --> INVOKE["Invoke Controller method"]
    INVOKE --> VALID["@Valid / data binding"]
    INVOKE --> SERVICE["@Service / @Transactional"]
    SERVICE --> DATA["@Repository / database"]
    VALID -. "MethodArgumentNotValidException" .-> RESOLVER
    SERVICE -. "BusinessException" .-> RESOLVER
    DATA -. "DataIntegrityViolationException" .-> RESOLVER
    INVOKE -. "unexpected Exception" .-> RESOLVER["HandlerExceptionResolver chain"]

    RESOLVER --> ADVICE["@RestControllerAdvice"]
    ADVICE --> BIZ["@ExceptionHandler BusinessException<br/>@Order 0"]
    ADVICE --> INTEGRITY["@ExceptionHandler DataIntegrityViolationException<br/>@Order 1"]
    ADVICE --> BINDING["@ExceptionHandler MethodArgumentNotValidException<br/>@Order 2"]
    ADVICE --> FALLBACK["@ExceptionHandler Exception<br/>lowest precedence"]
    BIZ --> ERR["Problem detail / error DTO<br/>HTTP status + code + trace id"]
    INTEGRITY --> ERR
    BINDING --> ERR
    FALLBACK --> ERR
    ERR --> RESP["JSON Error Response"]

    classDef spring fill:#e8f5e9,stroke:#43a047,color:#0b1a33
    classDef error fill:#fce4ec,stroke:#d81b60,color:#0b1a33
    class MVC,INVOKE,VALID,SERVICE,DATA spring
    class RESOLVER,ADVICE,BIZ,INTEGRITY,BINDING,FALLBACK,ERR,RESP error`,

