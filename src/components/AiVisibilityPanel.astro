---
// Owner-only AI-search visibility dashboard, first block of /palais (docs/AI_VISIBILITY.md). Hidden until the owner's data loads.
---
<section class="ai-visibility" id="ai-visibility" aria-labelledby="ai-visibility-heading" hidden>
  <header class="aiv-head">
    <h2 id="ai-visibility-heading">AI 搜尋曝光檢視</h2>
    <span id="ai-visibility-badge" class="aiv-badge" role="status"></span>
  </header>
  <p id="ai-visibility-headline" class="aiv-headline"></p>
  <div id="ai-visibility-platforms" class="aiv-platforms"></div>
  <div class="ai-visibility-scroll"><table id="ai-visibility-table" class="ai-visibility-table"></table></div>
  <p id="ai-visibility-trend" class="ai-visibility-note"></p>
  <ul id="ai-visibility-fixes" class="aiv-fixes"></ul>
  <details class="aiv-about">
    <summary>檢視方式</summary>
    <p>試跑 4 週（至 2026-12-15），完全由 AI 檢視：每週一 04:30 Claude 排程用 Gemini API（Google 搜尋）與自己的網頁搜尋，查本週 3 個關鍵字（1 固定＋2 輪替），再依結果修繕網站。ChatGPT、Grok 需付費 API，暫停。</p>
  </details>
</section>
<style>
  .ai-visibility { --aiv-hit: #3ecf8e; --aiv-miss: #f0b429; --aiv-line: color-mix(in srgb, currentColor 18%, transparent);
    padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--aiv-line); border-radius: 1rem; display: grid; gap: 1rem; min-width: 0; }
  .aiv-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .ai-visibility h2 { font-size: clamp(1.25rem, 3vw, 1.75rem); margin: 0; }
  .aiv-badge { font-size: 0.85rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 999px; border: 1px solid var(--aiv-line); font-variant-numeric: tabular-nums; }
  .aiv-badge.good { color: var(--aiv-hit); border-color: var(--aiv-hit); }
  .aiv-badge.none { color: var(--aiv-miss); border-color: var(--aiv-miss); }
  .aiv-headline { margin: 0; font-size: 0.9rem; opacity: 0.75; }
  .aiv-platforms { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 0.6rem; }
  .aiv-card { border: 1px solid var(--aiv-line); border-radius: 0.75rem; padding: 0.6rem 0.8rem; display: grid; gap: 0.15rem; }
  .aiv-card strong { font-size: 0.8rem; font-weight: 600; opacity: 0.75; }
  .aiv-card .num { font-size: 1.4rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .aiv-card small { font-size: 0.75rem; opacity: 0.65; }
  .aiv-card.off { border-style: dashed; opacity: 0.5; }
  .aiv-card.off .num { font-size: 1rem; }
  .aiv-card.hit .num { color: var(--aiv-hit); }
  .ai-visibility-scroll { overflow-x: auto; }
  .ai-visibility-table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 0.9rem; }
  .ai-visibility-table th { font-size: 0.75rem; font-weight: 600; opacity: 0.7; text-align: center; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--aiv-line); white-space: nowrap; }
  .ai-visibility-table th:first-child, .ai-visibility-table td:first-child { text-align: left; white-space: normal; min-width: 9rem; }
  .ai-visibility-table td { padding: 0.5rem 0.6rem; text-align: center; border-bottom: 1px solid var(--aiv-line); white-space: nowrap; }
  .ai-visibility-table tr:last-child td { border-bottom: 0; }
  .chip { display: inline-block; min-width: 4.5rem; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.8rem; border: 1px solid var(--aiv-line); }
  td.hit .chip { color: var(--aiv-hit); border-color: var(--aiv-hit); font-weight: 700; }
  td.miss .chip { opacity: 0.85; }
  td.na .chip { opacity: 0.4; border-style: dashed; }
  .ai-visibility-note { font-size: 0.85rem; opacity: 0.8; margin: 0; }
  .aiv-fixes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .aiv-fixes li { font-size: 0.85rem; padding: 0.5rem 0.75rem; border-left: 3px solid var(--aiv-hit); background: color-mix(in srgb, currentColor 5%, transparent); border-radius: 0.25rem; overflow-wrap: anywhere; }
  .aiv-fixes a { color: inherit; text-decoration: underline; }
  .aiv-about { font-size: 0.8rem; opacity: 0.7; }
  .aiv-about summary { cursor: pointer; }
  .aiv-about p { margin: 0.5rem 0 0; line-height: 1.6; }
</style>
<script>
  import { AUTO_PLATFORMS, PLATFORM_NAMES, cellLabel, headline, type VisibilityView } from '../scripts/palais/aiVisibility';

  const token = () => window.localStorage.getItem('token') || window.localStorage.getItem('accessToken');
  const el = (tag: string, cls?: string, text?: string) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text !== undefined) n.textContent = text; return n; };

  function linkify(li: HTMLElement, text: string) {
    text.split(/(https?:\/\/\S+)/).forEach((part) => {
      if (/^https?:\/\//.test(part)) {
        const a = el('a', undefined, part.replace(/^https?:\/\/(www\.)?/, '')) as HTMLAnchorElement;
        a.href = part; a.target = '_blank'; a.rel = 'noopener';
        li.appendChild(a);
      } else if (part) li.appendChild(document.createTextNode(part));
    });
  }

  async function loadAiVisibility() {
    const root = document.getElementById('ai-visibility');
    if (!root) return;
    const bearer = token();
    if (!bearer) return;
    const response = await fetch('/api/market/ai-visibility', { headers: { Authorization: `Bearer ${bearer}` }, cache: 'no-store' }).catch(() => null);
    if (!response?.ok) return;
    const view = await response.json() as VisibilityView;
    root.hidden = false;

    const badge = document.getElementById('ai-visibility-badge')!;
    badge.textContent = view.latest ? `出現 ${view.latest.appeared}/${view.latest.checked}` : '尚無結果';
    badge.className = `aiv-badge ${view.latest?.appeared ? 'good' : 'none'}`;
    document.getElementById('ai-visibility-headline')!.textContent = headline(view);

    const platforms = Object.keys(PLATFORM_NAMES);
    const cards = document.getElementById('ai-visibility-platforms')!;
    cards.replaceChildren();
    platforms.forEach((p) => {
      const totals = view.byPlatform[p];
      const live = AUTO_PLATFORMS.includes(p) || !!totals?.checked;
      const card = el('div', `aiv-card${!live ? ' off' : ''}${totals?.appeared ? ' hit' : ''}`);
      card.appendChild(el('strong', undefined, PLATFORM_NAMES[p]));
      if (!live) { card.appendChild(el('span', 'num', '暫停')); card.appendChild(el('small', undefined, '需 API 額度')); }
      else if (!totals?.checked) { card.appendChild(el('span', 'num', '—')); card.appendChild(el('small', undefined, '本週無法檢視')); }
      else { card.appendChild(el('span', 'num', `${totals.appeared}/${totals.checked}`)); card.appendChild(el('small', undefined, totals.bestRank ? `最佳 #${totals.bestRank}` : '格出現')); }
      cards.appendChild(card);
    });

    const keywords = [...new Set(view.cells.map((c) => c.keyword))];
    const table = document.getElementById('ai-visibility-table') as HTMLTableElement;
    table.replaceChildren();
    if (keywords.length) {
      const head = table.insertRow();
      ['關鍵字', ...platforms.map((p) => PLATFORM_NAMES[p])].forEach((text) => { const th = document.createElement('th'); th.textContent = text; head.appendChild(th); });
      keywords.forEach((keyword) => {
        const tr = table.insertRow();
        tr.insertCell().textContent = keyword;
        platforms.forEach((p) => {
          const cell = view.cells.find((c) => c.keyword === keyword && c.platform === p);
          const td = tr.insertCell();
          td.className = cell?.appeared ? 'hit' : cell?.status === 'checked' ? 'miss' : 'na';
          td.appendChild(el('span', 'chip', cell ? cellLabel(cell) : '—'));
        });
      });
    }
    document.getElementById('ai-visibility-trend')!.textContent = view.trend.length > 1
      ? `近 ${view.trend.length} 次出現格數：${view.trend.map((t) => `${t.appeared}/${t.checked}`).join(' → ')}` : '';
    const fixes = document.getElementById('ai-visibility-fixes')!;
    fixes.replaceChildren();
    view.fixes.forEach((f) => f.items.forEach((item) => { const li = el('li'); linkify(li, item); fixes.appendChild(li); }));
  }

  document.addEventListener('astro:page-load', loadAiVisibility);
  loadAiVisibility();
</script>
