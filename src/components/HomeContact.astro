---
import { CONTACT_EMAIL, CONTACT_TOPICS, mailtoHref } from '../scripts/contact';
import i18n from '../storages/i18n.json';

const topicText = i18n.home.contactTopic as Record<string, Record<'title' | 'body', { zh: string; en: string }>>;
---

<section class="home-cta" id="contact" aria-labelledby="home-cta-title">
    <div class="home-cta-inner">
        <p class="home-cta-eyebrow" data-i18n="home.contactEyebrow">聯繫 · 試用 · 合作</p>
        <h2 id="home-cta-title" class="home-cta-title" data-i18n="home.contactTitle">把你的研究流程，變成看得見的決策</h2>
        <p class="home-cta-lead" data-i18n="home.contactBody">試用、資料整合與功能需求都直接以 email 討論。選一個主題，信件會帶好要回答的問題。</p>
        <ol class="home-cta-topics">
            {CONTACT_TOPICS.map((topic, i) => (
                <li>
                    <a class="home-cta-topic" href={mailtoHref(topic.id, 'zh')} data-contact-topic={topic.id}>
                        <span class="home-cta-topic-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                        <strong data-i18n={`home.contactTopic.${topic.id}.title`}>{topicText[topic.id].title.zh}</strong>
                        <span class="home-cta-topic-body" data-i18n={`home.contactTopic.${topic.id}.body`}>{topicText[topic.id].body.zh}</span>
                        <span class="home-cta-topic-arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            ))}
        </ol>
        <div class="home-cta-direct">
            <span data-i18n="home.contactDirect">或直接寫信到</span>
            <a class="home-cta-address" href={mailtoHref('trial', 'zh')} data-contact-topic="trial">{CONTACT_EMAIL}</a>
            <button type="button" class="home-cta-copy" data-contact-copy={CONTACT_EMAIL} data-i18n="home.contactCopy">複製地址</button>
            <span class="home-cta-status" role="status" aria-live="polite"></span>
        </div>
    </div>
</section>

<!-- Without JS every link above is a plain mailto. With JS a click opens this chooser, because a bare mailto
     does nothing on a computer with no mail app. -->
<dialog class="contact-dialog" id="contact-dialog" aria-labelledby="contact-dialog-title">
    <form method="dialog" class="contact-dialog-close"><button type="submit" aria-label="Close">×</button></form>
    <p class="home-cta-eyebrow" data-i18n="home.contactDialogEyebrow">選擇寄信方式</p>
    <h3 id="contact-dialog-title"></h3>
    <pre class="contact-dialog-preview" id="contact-dialog-preview"></pre>
    <div class="contact-dialog-actions">
        <a id="contact-dialog-gmail" class="contact-dialog-primary" target="_blank" rel="noopener noreferrer" data-i18n="home.contactViaGmail">用 Gmail 寫信</a>
        <a id="contact-dialog-outlook" target="_blank" rel="noopener noreferrer" data-i18n="home.contactViaOutlook">用 Outlook 寫信</a>
        <a id="contact-dialog-mailto" data-i18n="home.contactViaApp">用電腦的郵件程式</a>
        <button type="button" id="contact-dialog-copy" data-i18n="home.contactCopyMail">複製信件內容</button>
    </div>
    <p class="home-cta-status" id="contact-dialog-status" role="status" aria-live="polite"></p>
</dialog>

<script>
    import { CONTACT_EMAIL, composeLinks, mailText, mailtoHref } from '../scripts/contact';

    const lang = () => ((window as any).AppLang?.get?.() === 'en' ? 'en' : 'zh');
    const zh = () => lang() === 'zh';
    let unsubscribe: (() => void) | null = null;

    // Every [data-contact-topic] link on the page (hero, maintainer, this section) keeps a mailto in the current
    // language as its no-JS fallback.
    function syncLinks() {
        document.querySelectorAll<HTMLAnchorElement>('a[data-contact-topic]')
            .forEach(link => { link.href = mailtoHref(link.dataset.contactTopic, lang()); });
    }

    async function copy(text: string) {
        try { await navigator.clipboard.writeText(text); return true; } catch { /* insecure context or denied: fall back */ }
        const field = Object.assign(document.createElement('textarea'), { value: text });
        field.setAttribute('readonly', ''); field.style.position = 'fixed'; field.style.opacity = '0';
        document.body.append(field); field.select();
        const ok = document.execCommand('copy'); field.remove();
        return ok;
    }

    function flash(status: HTMLElement, button: HTMLElement, ok: boolean, okText: [string, string]) {
        status.textContent = ok ? (zh() ? okText[0] : okText[1]) : (zh() ? '無法自動複製，請手動選取文字' : 'Could not copy. Please select the text.');
        button.classList.toggle('is-copied', ok);
        window.setTimeout(() => { status.textContent = ''; button.classList.remove('is-copied'); }, 4000);
    }

    function openChooser(topic: string) {
        const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;
        if (!dialog?.showModal) return false;
        const links = composeLinks(topic, lang());
        const card = document.querySelector(`.home-cta-topic[data-contact-topic="${topic}"] strong`);
        dialog.dataset.topic = topic;
        document.getElementById('contact-dialog-title')!.textContent = card?.textContent ?? CONTACT_EMAIL;
        document.getElementById('contact-dialog-preview')!.textContent = mailText(topic, lang());
        (document.getElementById('contact-dialog-gmail') as HTMLAnchorElement).href = links.gmail;
        (document.getElementById('contact-dialog-outlook') as HTMLAnchorElement).href = links.outlook;
        (document.getElementById('contact-dialog-mailto') as HTMLAnchorElement).href = links.mailto;
        document.getElementById('contact-dialog-status')!.textContent = '';
        dialog.showModal();
        return true;
    }

    function initHomeContact() {
        syncLinks();
        unsubscribe?.();
        unsubscribe = (window as any).AppLang?.onChange?.(syncLinks) ?? null;
        const dialog = document.getElementById('contact-dialog') as HTMLDialogElement | null;
        if (!dialog || dialog.dataset.bound) return;
        dialog.dataset.bound = 'true';
        document.querySelectorAll<HTMLAnchorElement>('a[data-contact-topic]').forEach(link => link.addEventListener('click', event => {
            if (openChooser(link.dataset.contactTopic ?? 'trial')) event.preventDefault();
        }));
        dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); }); // backdrop
        const copyMail = document.getElementById('contact-dialog-copy')!;
        copyMail.addEventListener('click', async () => flash(document.getElementById('contact-dialog-status')!, copyMail,
            await copy(mailText(dialog.dataset.topic, lang())), ['已複製收件人、主旨與內容，貼到任何信箱即可', 'Copied the recipient, subject and text. Paste into any mail service.']));
        const copyAddress = document.querySelector<HTMLButtonElement>('.home-cta [data-contact-copy]');
        copyAddress?.addEventListener('click', async () => flash(document.querySelector<HTMLElement>('.home-cta-direct .home-cta-status')!, copyAddress,
            await copy(copyAddress.dataset.contactCopy!), ['已複製，貼到任何信箱即可寄出', 'Copied. Paste it into any mail app.']));
    }

    document.addEventListener('astro:page-load', initHomeContact);
</script>
