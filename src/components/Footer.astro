---
import { Icon } from './Icon';
import { buildRevision } from '../scripts/buildRevision';
import { socialLinks } from '../scripts/socialLinks';
import type { iconPaths } from './IconPaths';
const currentYear = new Date().getFullYear();
const revision = buildRevision(import.meta.env.PUBLIC_BUILD_REVISION);
---

<footer>
	<div class="group">
		<p><span data-i18n="home.productBrand">TY Multiverse · TY 市場研究室</span> · <span data-i18n="home.productName">Birch Investments 樺樹資本工具</span></p>
		<p>&copy; {currentYear} TY Multiverse</p>
	</div>
	<div class="social-links">
		{socialLinks.map(({ href, icon, label }) => <a href={href} target="_blank" rel="noopener noreferrer">
			<Icon icon={icon as keyof typeof iconPaths} />
			<span>{label}</span>
		</a>)}
	</div>
	{revision && <div class="version"><span data-i18n="home.buildVersion">版本</span> {revision}</div>}
</footer>
