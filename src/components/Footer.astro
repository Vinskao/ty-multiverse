---
import { Icon } from './Icon';
import { buildRevision } from '../scripts/buildRevision';
const currentYear = new Date().getFullYear();
const revision = buildRevision(import.meta.env.PUBLIC_BUILD_REVISION);
---

<footer>
	<div class="group">
		<p>
			Designed by TY
		</p>
		<p>&copy; {currentYear} TY Multiverse</p>
	</div>
	<div class="social-links">
		<a href="https://twitter.com/wawiking">
			<Icon icon="twitter-logo" />
			<span>Twitter</span>
		</a>
		<a href="https://github.com/Vinskao">
			<Icon icon="github-logo" />
			<span>GitHub</span>
		</a>
	</div>
	{revision && <div class="version"><span data-i18n="home.buildVersion">版本</span> {revision}</div>}
</footer>
