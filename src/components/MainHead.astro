---

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	canonical?: string;
	robots?: string;
	lang?: string;
}

const {
	title = "TY Multiverse",
	description = "The personal site of Tianyi Kao",
	canonical,
	robots = 'index,follow,max-image-preview:large',
	lang = 'en',
} = Astro.props;
const socialImage = 'https://tymultiverse.cc/assets/og-market-lab.png';
const ogLocale = lang.toLowerCase().startsWith('zh') ? 'zh_TW' : 'en_US';
---

<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="TY 市場研究室" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="TY 市場研究室：市場、技術、供應鏈與總體經濟研究" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content="TY 市場研究室：市場、技術、供應鏈與總體經濟研究" />
<meta name="robots" content={robots} />
<meta name="monetag" content="c55e19a2bd74503d47acba679da8d1a9" />
{canonical && <link rel="canonical" href={canonical} />}
{canonical && <meta property="og:url" content={canonical} />}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content="#667eea" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,700;1,400&family=Rubik:wght@500;600&display=swap"
	rel="stylesheet"
/>
