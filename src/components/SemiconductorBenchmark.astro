---
import { lineupLegend, supplyChainDiagram, type LineupVersion } from '../scripts/market/benchmarkChain';
import { monitorDiagram, type BenchmarkMonitor } from '../scripts/market/benchmarkMonitor';

type BenchmarkRow = {
  code: string;
  company_name: string;
  segment: string;
  significance: string;
  report_year: number | null;
  report_url: string;
  financial_year: number | null;
  financial_url: string | null;
};

const base = process.env.MAYA_SAWA_INTERNAL_URL || import.meta.env.MAYA_SAWA_INTERNAL_URL || 'http://maya-sawa/maya-sawa';
let rows: BenchmarkRow[] | null = null;
try {
  const response = await fetch(`${base}/market/benchmark`, { signal: AbortSignal.timeout(2000) });
  if (response.ok) rows = await response.json();
} catch { /* A failed benchmark request leaves the research library usable. */ }

// Line-up versions, newest first. Without them (older backend, request failed) the diagram falls back
// to grouping the active companies by segment.
let versions: LineupVersion[] = [];
try {
  const response = await fetch(`${base}/market/benchmark/versions`, { signal: AbortSignal.timeout(2000) });
  if (response.ok) versions = await response.json();
} catch { /* fall back below */ }
const current = versions.find(version => version.is_current) ?? null;

// The year's AI long-term outlook, set from these companies' annual reports; daily readings and analyses build on it.
let outlook: { content: string; revision: number; updated_at?: string } | null = null;
try {
  const response = await fetch(`${base}/market/dashboard/analysis/AI?productType=outlook`, { signal: AbortSignal.timeout(2000) });
  if (response.ok) outlook = (await response.json()).analysis ?? null;
} catch { /* the outlook is optional context */ }
const earlier = versions.filter(version => version !== current);
let monitor: BenchmarkMonitor = { nodes: [], holdings: [], revision: '' };
try {
  const response = await fetch(`${base}/market/benchmark/monitor`, { signal: AbortSignal.timeout(3000) });
  if (response.ok) monitor = await response.json();
} catch { /* unavailable evidence stays explicitly unknown */ }
---

<section id="benchmark" aria-labelledby="benchmark-title" data-lineup={current ? JSON.stringify(current) : ''}>
  <h4 id="benchmark-title">半導體供應鏈 Benchmark</h4>
  <ol class="benchmark-method">
    <li><strong>Benchmark</strong>每個環節只選龍頭一家，只讀它的股東會年報，用經營階層對需求、產能與資本支出的說法定調產業指引與景氣位置。這些公司是量尺，不是買進標的。</li>
    <li><strong><a href="/macro/">總體</a></strong>用利率、流動性與景氣循環判斷產業現在走到哪個階段，決定該偏重哪些環節。</li>
    <li><strong><a href="/stocks/">個體</a></strong>回到預計買進的公司，用 Benchmark 定下的指引與景氣位置，檢查它的營收、訂單與展望是否說得通。</li>
  </ol>
  <p>下方的研究報告依這條路線蒐集與選讀。年報與年度財務報告分開查閱。</p>
  {current && <p class="benchmark-version"><strong>第 {current.version} 版・{current.name}</strong>　{current.rationale}</p>}
  {(current || rows?.length) ? <details class="overview"><summary>供應鏈綜觀研究圖・產業風向與持股定位</summary><pre class="mermaid">{current ? monitorDiagram(current, monitor) : supplyChainDiagram(rows ?? [])}</pre>
    {current && lineupLegend(current).length ? <p class="benchmark-legend">箭頭從供應者指向客戶。{lineupLegend(current).map(item => item.label).join('；')}。</p> : null}
  </details> : null}
  <p>綠色為年報順風，紅色為逆風，黃色為多空並存，灰色為缺資料。金框與星號標示持股。年報說法與近期驗證分開呈現。</p>
  <p>支持／反駁占比只計已審核條件的權重，未知也留在分母，並非報酬率或預測機率。持股的整體營收僅為代理指標，不能直接證明 AI 產品需求。</p>
  <label>查看年報依據與驗證數據 <select data-benchmark-evidence aria-label="選擇 Benchmark 年報依據">
    <option value="">選擇圖上的公司</option>
    {(current?.layers ?? []).flatMap(layer => layer.stages.flatMap(stage => stage.companies)).map(company =>
      <option value={company.code}>{company.company_name} {company.code}</option>)}
  </select></label>
  <div data-benchmark-readout aria-live="polite">選擇公司查看年報頁碼、原文、實際值與門檻理由。</div>
  <p data-benchmark-status role="status"></p>
  {outlook ? <details class="benchmark-outlook"><summary>年度 AI 長線格局（第 {outlook.revision} 版）</summary>
    <p class="benchmark-outlook-note">由上方龍頭的股東年報定調；每日精讀與個股 AI 分析都用「長線格局對照」把短線資料放回這些主軸。</p>
    <div class="benchmark-outlook-body">{outlook.content}</div>
  </details> : null}
  {earlier.length ? <details class="benchmark-versions"><summary>先前版本</summary>
    {earlier.map(version => <div>
      <p><strong>第 {version.version} 版・{version.name}</strong>　{version.rationale}</p>
      <p>{version.layers.flatMap(layer => layer.stages.flatMap(stage => stage.companies.map(company => `${company.company_name} ${company.code}`))).join('、')}</p>
    </div>)}
  </details> : null}
  {!current && !rows?.length && <p>Benchmark 資料暫未載入。</p>}
</section>
<script>
  import { initBenchmarkDiagram } from '../scripts/market/benchmarkDiagram';
  import { initBenchmarkMonitor } from '../scripts/market/benchmarkMonitorClient';
  initBenchmarkDiagram();
  initBenchmarkMonitor();
  document.addEventListener('astro:page-load', () => { initBenchmarkDiagram(); initBenchmarkMonitor(); });
</script>

<style>
  section { margin-block: 1rem; font-size: .95rem; }
  .benchmark-outlook-body { white-space: pre-line; line-height: 1.7; }
  .benchmark-outlook-note, .benchmark-legend { color: var(--gray-400); font-size: .85rem; }
  h4 { margin: 0 0 .5rem; font-size: 1.1rem; }
  table { font-size: .9rem; }
  .benchmark-method { margin: .5rem 0; padding-inline-start: 1.4rem; line-height: 1.7; }
  .benchmark-method strong { margin-inline-end: .5rem; }
  .benchmark-version { line-height: 1.7; }
  .benchmark-versions { margin-block: .5rem 1rem; }
  .benchmark-versions summary { cursor: pointer; }
  .benchmark-versions p { margin: .5rem 0; line-height: 1.7; }
  .overview { margin: .75rem 0 1rem; border: 1px solid #8885; border-radius: .6rem; }
  .overview summary { cursor: pointer; padding: .7rem 1rem; font-weight: 650; }
  .overview pre.mermaid { overflow-x: auto; margin: 0; padding: .75rem; background: transparent; }
  .overview pre.mermaid :global(svg) { display: block; min-width: 52rem; max-width: 100%; height: auto; margin-inline: auto; }
  .benchmark-table { overflow-x: auto; }
  table { width: 100%; min-width: 44rem; border-collapse: collapse; }
  th, td { padding: .65rem; text-align: start; vertical-align: top; border-bottom: 1px solid #8885; }
  th:first-child { min-width: 8rem; }
  td:last-child { min-width: 10rem; }
</style>
