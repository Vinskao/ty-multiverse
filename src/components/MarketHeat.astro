<div id="market-heat" hidden role="status" aria-live="polite" data-level="warn" data-dir="down">
  <span class="heat-wave" aria-hidden="true"></span><span class="heat-fx" aria-hidden="true"></span>
  <span class="heat-icon" aria-hidden="true"><i class="heat-ring"></i><i class="heat-ring"></i><i class="heat-ring"></i><span class="heat-fire">🔥</span></span>
  <div class="heat-text"><a class="heat-headline"><strong></strong></a><span class="heat-details"></span><small></small></div>
  <button aria-label="關閉市場狀態條">×</button>
</div>
<script>
import { pickHeat, type HeatStatus } from '../scripts/market/marketHeat';

const POLL_MS = 60_000;
let timer: number | undefined;
let last: HeatStatus | null = null;
const lang = () => ((window as any).AppLang?.get?.() === 'zh' ? 'zh' : 'en') as 'zh' | 'en';
const dismissed = (key: string) => { try { return !!sessionStorage.getItem(key); } catch { return false; } };

function render() {
  const el = document.querySelector<HTMLElement>('#market-heat');
  if (!el) return;
  const heat = pickHeat(last, lang());
  if (!heat || dismissed(heat.key)) { el.hidden = true; return; }
  const wasHidden = el.hidden;
  el.dataset.level = heat.level; el.dataset.dir = heat.dir;
  el.querySelector('.heat-fire')!.textContent = heat.icon;
  const headline = el.querySelector<HTMLAnchorElement>('.heat-headline')!;
  headline.querySelector('strong')!.textContent = heat.headline;
  if (heat.href) headline.setAttribute('href', heat.href); else headline.removeAttribute('href');
  // Each detail is its own link to the page that shows that number.
  const details = el.querySelector('.heat-details')!;
  details.replaceChildren(...heat.details.flatMap((detail, index) => {
    const node = detail.href ? Object.assign(document.createElement('a'), { href: detail.href }) : document.createElement('span');
    node.textContent = detail.text;
    return index ? [document.createTextNode(' · '), node] : [node];
  }));
  el.querySelector('small')!.textContent = heat.footnote;
  el.hidden = false;
  if (wasHidden) { el.classList.remove('heat-enter'); void el.offsetWidth; el.classList.add('heat-enter'); }   // restart the entrance shock
  el.querySelector('button')!.onclick = () => { el.hidden = true; try { sessionStorage.setItem(heat.key, '1'); } catch { /* private mode */ } };
}

async function refresh() {
  if (!document.querySelector('#market-heat') || location.pathname.startsWith('/palais')) return;
  try {
    const response = await fetch('/api/market/dashboard/status');
    if (!response.ok) return;
    last = await response.json() as HeatStatus;
    render();
  } catch { /* Keep the banner as it is when market data is unavailable. */ }
}

// The bar sticks right under the navbar, whatever height the navbar has (mobile menu, wrapped links).
let navWatch: ResizeObserver | undefined;
function followNav() {
  const nav = document.querySelector('nav');
  if (!nav) return;
  const set = () => document.documentElement.style.setProperty('--heat-top', `${Math.round(nav.getBoundingClientRect().height)}px`);
  set();
  navWatch?.disconnect();
  if ('ResizeObserver' in window) { navWatch = new ResizeObserver(set); navWatch.observe(nav); }
}

function start() {
  followNav();
  void refresh();
  if (timer === undefined) timer = window.setInterval(() => { if (!document.hidden) void refresh(); }, POLL_MS);
}
start();
document.addEventListener('astro:page-load', () => { last = null; followNav(); void refresh(); });
(window as any).AppLang?.onChange?.(render);
window.addEventListener('site:language-change', render);
</script>
