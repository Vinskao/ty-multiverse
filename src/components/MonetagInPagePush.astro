---
interface Props { showSlot: boolean }
const { showSlot } = Astro.props;
---
{showSlot && <section class="learn-in-page-push" aria-label="Monetag In-Page Push">
	<div id="monetag-ipp" data-monetag-zone="12196776"></div>
</section>}
<script>
	import { mountPublisherAds, unmountPublisherAds } from '../scripts/ads/consentAds';
	import { observeMonetagFloatingAds } from '../scripts/ads/monetagPosition';
	import { COOKIE_CONSENT_STORAGE_KEY, hasAdvertisingConsent } from '../scripts/cookies/consent';
	import { showsPublisherAds } from '../scripts/ads/placement';
	const adFree = () => !showsPublisherAds(location.pathname);
	const syncPublisherAds = () => {
		if (adFree()) { unmountPublisherAds(document); return; }
		void mountPublisherAds(document, hasAdvertisingConsent(localStorage.getItem(COOKIE_CONSENT_STORAGE_KEY)));
	};
	document.addEventListener('astro:page-load', syncPublisherAds);
	document.addEventListener('astro:before-swap', () => unmountPublisherAds(document));
	window.addEventListener('cookie-consent:changed', (event) => {
		const allowed = (event as CustomEvent<{ advertising?: boolean }>).detail?.advertising === true;
		void mountPublisherAds(document, allowed);
	});
	syncPublisherAds();
	observeMonetagFloatingAds(document, adFree);
</script>
